    def ask_whitelist(self, scope_global=False):
        if self.cm is None:
            self.flash = (time.monotonic(), "Whitelist désactivée (--no-exclusions)", False)
            return
        if not self.ms_rows:
            return
        r = self.ms_rows[min(self.ms_cur, len(self.ms_rows) - 1)]
        host = "" if (scope_global or not r["host"]) else r["host"]
        already = self.cm.excluded(host, r["rid"]) if host else (("", r["rid"]) in self.cm.keys)
        svc, status = (host, "ok")
        if host and not already:
            svc, status = self.cm.backend.resolve_service(host)
        scope_txt = "globalement (tous les services)" if not host else "pour le service %s" % svc
        if already:
            lines = [("Réactiver la règle ModSecurity %s %s ?" % (r["rid"], scope_txt), curses.A_BOLD),
                     ("", 0),
                     ("La règle n'était plus appliquée. Elle le sera de nouveau.", 0),
                     ("Le blocage légitime qu'elle assure revient.", curses.A_DIM)]
        else:
            lines = [("Désactiver la règle ModSecurity %s %s ?" % (r["rid"], scope_txt), curses.A_BOLD),
                     ("", 0),
                     ("Message : " + (r["msg"] or "(inconnu)"), curses.A_DIM),
                     ("Exemple d'URL : " + (r["uri"] or "-"), curses.A_DIM),
                     ("", 0),
                     ("Directive écrite (type modsec, après le CRS) :", self.attr[C_TITLE]),
                     ("    SecRuleRemoveById %s;" % r["rid"], self.attr[C_MAG] | curses.A_BOLD),
                     ("Application : " + self.cm.backend.live_note, curses.A_DIM)]
            if status == "unmatched":
                lines.append(("⚠ « %s » ne correspond à aucun service connu (alias ?). Vérifie, ou utilise g (global)."
                              % host, self.attr[C_WARN]))
            lines.append(("⚠ désactiver une règle réduit la protection : ne vise qu'un vrai faux positif.",
                          self.attr[C_WARN]))
        self.modal = ("fpconfirm", r, host, bool(already), lines)

