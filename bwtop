                    "RAISON": (b["reason"], 0), "BANNI LE": (when, curses.A_DIM),
                    "RESTANT": (left, self.attr[C_BAD] if b["left"] is None else 0),
                    "PAYS": (b["country"], curses.A_DIM),
                    "TYPE": (kind, self.attr[C_MAG] if kind == "crowdsec" else curses.A_DIM),
                    "REQ BLOQ.": (fmt_n(b["hits"]) if b["hits"] else "-", curses.A_BOLD if b["hits"] else curses.A_DIM)}
            x = 2
            for name, wd in cols:
                txt, a = vals[name]
