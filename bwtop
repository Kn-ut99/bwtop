TERMINFO_PATHS = ("/etc/terminfo", "/lib/terminfo", "/usr/share/terminfo", "/usr/lib/terminfo",
                  "/usr/local/share/terminfo", "/usr/share/lib/terminfo")


def ensure_terminfo():
    """Rend curses robuste dans un binaire PyInstaller / sous sudo.

    La libncurses embarquee garde les chemins terminfo de la machine de build ; on lui
    indique ceux de la machine courante, et on se rabat sur xterm-256color si le TERM
    est absent ou inconnu (ex. xterm-kitty, alacritty, TERM perdu par sudo...).
    """
    if not os.environ.get("TERMINFO"):
        dirs = [d for d in TERMINFO_PATHS if os.path.isdir(d)]
        if dirs:
            cur = [d for d in os.environ.get("TERMINFO_DIRS", "").split(":") if d]
            os.environ["TERMINFO_DIRS"] = ":".join(cur + [d for d in dirs if d not in cur]) + ":"
    if not os.environ.get("TERM"):
        os.environ["TERM"] = "xterm-256color"
    try:
        curses.setupterm()
    except curses.error:
        bad = os.environ.get("TERM")
        os.environ["TERM"] = "xterm-256color"
        try:
            curses.setupterm()
        except curses.error:
            sys.exit("bwtop: base terminfo introuvable (TERM=%s). Installe-la : "
                     "apt install ncurses-base ncurses-term  |  dnf install ncurses-base" % bad)


