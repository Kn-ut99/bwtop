def last_lines(path, n):
    with open(path, "rb") as f:
        f.seek(0, 2)
        pos, data = f.tell(), b""
        while pos > 0 and data.count(b"\n") <= n:
            step = min(65536, pos)
            pos -= step
            f.seek(pos)
            data = f.read(step) + data
        lines = data.split(b"\n")
        if pos > 0:
            lines = lines[1:]
        return [l.decode("utf-8", "replace") for l in lines[-n:] if l]


def tail_file(path, q, backlog, notes, stop):
    key = os.path.basename(path)
    first = True
    f, ino = None, None
    while not stop.is_set():
        try:
            if first and backlog > 0:
                for l in last_lines(path, backlog):
                    q.put((l, None))
            f = open(path, "r", encoding="utf-8", errors="replace")
            ino = os.fstat(f.fileno()).st_ino
            if first:
                f.seek(0, 2)
            notes[key] = None
            break
        except OSError as e:
            notes[key] = "%s: %s" % (path, e.strerror)
            time.sleep(2)
    first = False
    buf = ""
    while not stop.is_set():
        chunk = f.readline()
        if chunk:
            buf += chunk
            if buf.endswith("\n"):
                q.put((buf.rstrip("\r\n"), None))
                buf = ""
            continue
        time.sleep(0.2)
        try:
            st = os.stat(path)
            if st.st_ino != ino or st.st_size < f.tell():     # rotation / truncate
                for rest in f:                                # on vide l'ancien fichier d'abord
                    buf += rest
                    if buf.endswith("\n"):
                        q.put((buf.rstrip("\r\n"), None))
                        buf = ""
                f.close()
                f = open(path, "r", encoding="utf-8", errors="replace")
                ino = os.fstat(f.fileno()).st_ino
                buf = ""
        except OSError:
            pass


_procs = []


def docker_follow(container, q, backlog, notes, stop):
    while not stop.is_set():
        cmd = ["docker", "logs", "-t", "-f", "--tail", str(backlog), container]
        try:
            p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                 text=True, errors="replace", bufsize=1)
        except OSError as e:
            notes["docker"] = "docker: %s" % e.strerror
            return
        _procs.append(p)
        notes["docker"] = None
        for line in p.stdout:
            line = line.rstrip("\r\n")
            m = DOCKER_TS_RE.match(line)
            hint = None
            if m:
                hint = float(calendar.timegm(tuple(int(x) for x in m.groups())))
                line = line[m.end():]
            q.put((line, hint))
        p.wait()
        notes["docker"] = "docker logs terminé (code %s), nouvelle tentative..." % p.returncode
        time.sleep(3)


def stdin_follow(pipe, q, stop):
    for line in pipe:
        if stop.is_set():
            break
        q.put((line.rstrip("\r\n"), None))


