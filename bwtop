    def put(self, y, x, text, attr=0, maxw=None):
        h, w = self.s.getmaxyx()
        if y < 0 or y >= h or x >= w or x < 0:
            return
        maxw = (w - x) if maxw is None else min(maxw, w - x)
        if maxw <= 0:
            return
        try:
            self.s.addstr(y, x, text[:maxw], attr)
        except curses.error:
            pass

    def box(self, y, x, h, w, title="", right=""):
        if h < 3 or w < 6:
            return
        b = self.border
        self.put(y, x, "╭" + "─" * (w - 2) + "╮", b)
        for i in range(1, h - 1):
            self.put(y + i, x, "│", b)
            self.put(y + i, x + w - 1, "│", b)
        self.put(y + h - 1, x, "╰" + "─" * (w - 2) + "╯", b)
        if title:
            self.put(y, x + 2, "┤", b)
            self.put(y, x + 3, " %s " % title, self.attr[C_TITLE] | curses.A_BOLD, w - 6)
            self.put(y, x + 5 + len(title), "├", b)
        if right:
            self.put(y, x + w - len(right) - 3, " %s " % right, curses.A_DIM)

