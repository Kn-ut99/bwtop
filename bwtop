# Meme ordre que bwcli : les fichiers de l'operateur d'abord, le fichier genere ensuite.
VARIABLES_FILES = ("/etc/bunkerweb/variables.env", "/etc/bunkerweb/scheduler.env", "/etc/nginx/variables.env")
ANSI_RE = re.compile(r'\x1b\[[0-9;]*[A-Za-z]')


def read_env_files(paths=VARIABLES_FILES):
    out, read = {}, []
    for p in paths:
        try:
            with open(p, encoding="utf-8", errors="replace") as f:
                for line in f:
                    line = line.strip()
                    if not line or line.startswith("#") or "=" not in line:
                        continue
                    k, v = line.split("=", 1)
                    k, v = k.strip(), v.strip()
                    if k.startswith("export "):
                        k = k[7:].strip()
                    if len(v) >= 2 and v[0] == v[-1] and v[0] in "'\"":
                        v = v[1:-1]
                    out.setdefault(k, v)
            read.append(p)
        except OSError:
            pass
    return out, read


class BanError(Exception):
    pass


class BanClient:
    """Client HTTP minimal (stdlib) pour l'API des bans.

    kind="instance" : API interne de l'instance BunkerWeb (GET /bans, POST /unban), Host: bwapi.
    kind="central"  : service bunkerweb-api (GET /bans, POST /bans/unban).
    """

    def __init__(self, url, host="bwapi", token=None, kind="instance", timeout=4.0, insecure=False):
        import ssl
        import urllib.request
        self.url = url.rstrip("/")
        self.host, self.token, self.kind, self.timeout = host, token, kind, timeout
        handlers = [urllib.request.ProxyHandler({})]          # jamais via http_proxy
        if self.url.startswith("https://"):
            ctx = ssl.create_default_context()
            if insecure:
                ctx.check_hostname = False
                ctx.verify_mode = ssl.CERT_NONE
            handlers.append(urllib.request.HTTPSHandler(context=ctx))
        self.opener = urllib.request.build_opener(*handlers)

    def label(self):
        return "%s (%s)" % (self.url, "API instance" if self.kind == "instance" else "bunkerweb-api")

    def _req(self, method, path, body=None):
        import json
        import urllib.error
        import urllib.request
        data = json.dumps(body).encode() if body is not None else None
        req = urllib.request.Request(self.url + path, data=data, method=method)
        req.add_header("User-Agent", "bwtop/" + VERSION)
        req.add_header("Accept", "application/json")
        if self.host:
            req.add_header("Host", self.host)
        if self.token:
            req.add_header("Authorization", "Bearer " + self.token)
        if data is not None:
            req.add_header("Content-Type", "application/json")
        try:
            with self.opener.open(req, timeout=self.timeout) as r:
                raw = r.read()
                code = r.status
        except urllib.error.HTTPError as e:
            raw, code = e.read(), e.code
        except urllib.error.URLError as e:
            reason = getattr(e, "reason", e)
            raise BanError("%s injoignable : %s" % (self.url, getattr(reason, "strerror", None) or reason))
        except OSError as e:
            raise BanError("%s : %s" % (self.url, e))
        try:
            js = json.loads(raw.decode("utf-8", "replace")) if raw else {}
        except ValueError:
            js = {"msg": raw.decode("utf-8", "replace")[:200]}
        if code >= 400:
            msg = ""
            if isinstance(js, dict):
                msg = js.get("msg") or js.get("message") or js.get("detail") or ""
            hint = ""
            if code in (401, 403):
                hint = " (API_TOKEN ou API_WHITELIST_IP ?)"
            elif code == 404 and self.kind == "instance":
                hint = " (Host « %s » attendu = API_SERVER_NAME ?)" % self.host
            raise BanError("HTTP %d %s%s" % (code, str(msg)[:160], hint))
        return code, js

    def list(self):
        _, js = self._req("GET", "/bans")
        rows = []
        if isinstance(js, list):
            rows = js
        elif isinstance(js, dict) and isinstance(js.get("data"), list):
            rows = js["data"]
        elif isinstance(js, dict):                      # bunkerweb-api : {instance: {data: [...]}}
            for v in js.values():
                if isinstance(v, dict) and isinstance(v.get("data"), list):
                    rows.extend(v["data"])
        return normalize_bans(rows)

    def unban(self, ban):
        body = {"ip": ban["ip"]}
        if ban["scope"] == "service" and ban["service"]:
            body["service"] = ban["service"]
        if self.kind == "instance":
            body["ban_scope"] = ban["scope"]
            _, js = self._req("POST", "/unban", body)
        else:
            _, js = self._req("POST", "/bans/unban", body)
        if isinstance(js, dict) and js.get("status") not in (None, "success"):
            raise BanError(str(js.get("msg") or js.get("message") or js))
        return True

    def remove_lease(self, ban):
        """Retire la copie locale d'une decision CrowdSec (POST /remove_lease, BunkerWeb 1.6 recent)."""
        if self.kind != "instance":
            raise BanError("retrait de la copie CrowdSec non géré via bunkerweb-api : utilise l'API instance")
        body = {"ip": ban["ip"], "ban_scope": ban["scope"]}
        if ban["scope"] == "service" and ban["service"]:
            body["service"] = ban["service"]
        try:
            self._req("POST", "/remove_lease", body)
        except BanError as e:
            if "HTTP 404" in str(e):
                raise BanError("/remove_lease absent (BunkerWeb trop ancien ?) : la copie expirera seule")
            raise
        return True


class CrowdSecCli:
    """Decisions CrowdSec via cscli (bwtop tourne en root : cscli a acces a la LAPI locale)."""

    def __init__(self, cmd="cscli"):
        import shlex
        self.cmd = shlex.split(cmd) or ["cscli"]

    def label(self):
        return " ".join(self.cmd)

    def _run(self, args, timeout=30):
        try:
            p = subprocess.run(self.cmd + args, capture_output=True, text=True, timeout=timeout)
        except FileNotFoundError:
            raise BanError("%s introuvable (option --cscli)" % self.cmd[0])
        except (OSError, subprocess.TimeoutExpired) as e:
            raise BanError("cscli : %s" % e)
        out = ANSI_RE.sub("", p.stdout or "")
        err = ANSI_RE.sub("", p.stderr or "")
        if p.returncode != 0:
            lines = [l for l in (err + "\n" + out).splitlines() if l.strip()]
            raise BanError("cscli (code %d) : %s" % (p.returncode, lines[-1][:160] if lines else ""))
        return out, err

    def decisions(self, ip):
        import json
        out, _ = self._run(["decisions", "list", "-a", "--ip", ip, "-l", "0", "-o", "json"])
        try:
            data = json.loads(out.strip() or "null")
        except ValueError:
            raise BanError("cscli : sortie JSON illisible")
        found = []
        for item in data or []:
            if not isinstance(item, dict):
                continue
            decs = item.get("decisions") if "decisions" in item else [item]
            for d in decs or []:
                if isinstance(d, dict):
                    found.append({"id": d.get("id"), "type": str(d.get("type") or "?"),
                                  "origin": str(d.get("origin") or "?"), "scenario": str(d.get("scenario") or ""),
                                  "duration": str(d.get("duration") or "")})
        return found

    def delete(self, ip):
        out, err = self._run(["decisions", "delete", "--ip", ip])
        m = re.search(r"(\d+)\s+decision", out + err)
        return int(m.group(1)) if m else None


