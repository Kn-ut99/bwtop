        cmd = self.prefix + ["bwcli", "unban", ban["ip"]]
        if ban["scope"] == "service" and ban["service"]:
            cmd += ["-service", ban["service"]]
        try:
            p = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
        except (OSError, subprocess.TimeoutExpired) as e:
            raise BanError("bwcli : %s" % e)
        out = ANSI_RE.sub("", (p.stdout or "") + (p.stderr or "")).strip().splitlines()
        if p.returncode != 0:
            raise BanError("bwcli (code %d) : %s" % (p.returncode, out[-1] if out else ""))
        return True

    def remove_lease(self, ban):
        return self.lister.remove_lease(ban)


def normalize_bans(rows):
    out, seen = [], set()
    now = time.monotonic()
    for r in rows:
        if not isinstance(r, dict) or not r.get("ip"):
            continue
        svc = r.get("service")
        scope = r.get("ban_scope") or ("global" if svc in (None, "", "_", "unknown", "bwcli", "Web UI") else "service")
        if scope == "global":
            svc = ""
        kind = r.get("kind") or "ban"
        key = (r["ip"], scope, svc, kind)
        if key in seen:
            continue
        seen.add(key)
        try:
            exp = float(r.get("exp") or 0)
        except (TypeError, ValueError):
            exp = 0.0
        try:
            date = float(r.get("date") or 0)
        except (TypeError, ValueError):
            date = 0.0
        out.append({"ip": str(r["ip"]), "scope": scope, "service": svc or "",
                    "reason": clean(str(r.get("reason") or "-"), 60), "date": date, "exp": exp,
                    "permanent": bool(r.get("permanent")) or exp <= 0, "kind": kind,
                    "country": str(r.get("country") or "")[:4], "at": now})
    return out


