    def ask_unban(self, all_scopes=False):
        if self.bm is None or not self.ban_rows:
            return
        cur = self.ban_rows[min(self.ban_cur, len(self.ban_rows) - 1)]
        if all_scopes:
            targets = [b for b in self.bm.bans if b["ip"] == cur["ip"]]
        else:
            targets = [cur]
        cs = [b for b in targets if b["kind"] == "crowdsec_lease"]
        if not self.cs_on:
            targets = [b for b in targets if b["kind"] != "crowdsec_lease"]
        if not targets:
            hint = ("active la suppression CrowdSec avec la touche C, ou sur le serveur :"
                    if self.bm.cs is not None else "sur le serveur :")
            self.modal = ("info", ["%s est bloquée par une décision CrowdSec." % cur["ip"],
                                   "Pour la lever, " + hint,
                                   "    bwcli unban %s%s -confirm" % (cur["ip"], (" -service " + cur["service"])
                                                                      if cur["scope"] == "service" else "")])
            return
        lines = []
        for b in targets:
            where = "globalement" if b["scope"] == "global" else "du site %s" % b["service"]
            what = "Retirer le ban CrowdSec de" if b["kind"] == "crowdsec_lease" else "Débannir"
            lines.append("%s %s %s ?" % (what, b["ip"], where))
        if cs and not self.cs_on:
            lines.append("(%d ban(s) CrowdSec ignoré(s) : touche C pour les inclure)" % len(cs))
        cs_ips = sorted({b["ip"] for b in targets}) if self.cs_on else []
        for ip in cs_ips:
            self.cs_prev[ip] = ("loading", None)
            threading.Thread(target=self._cs_preview, args=(ip,), daemon=True).start()
        self.modal = ("confirm", targets, lines, cs_ips)

    def _cs_preview(self, ip):
        try:
            self.cs_prev[ip] = ("ok", self.bm.cs.decisions(ip))
        except BanError as e:
            self.cs_prev[ip] = ("err", str(e))
        except Exception as e:
            self.cs_prev[ip] = ("err", "%s: %s" % (type(e).__name__, e))

    def key_modal(self, k):
        m = self.modal
        if m == "help" or (isinstance(m, tuple) and m[0] == "info"):
            self.modal = None
            return
        if isinstance(m, tuple) and m[0] == "confirm":
            if k in (ord("o"), ord("O"), ord("y"), ord("Y")):
                cs_ips = [ip for ip in m[3] if self.cs_prev.get(ip, ("",))[0] != "err"]
                bans = [b for b in m[1] if b["kind"] != "crowdsec_lease" or b["ip"] in cs_ips]
                self.bm.unban(bans, cs_ips)
                self.flash = (time.monotonic(), "Unban de %s en cours…" % ", ".join(sorted({b["ip"] for b in m[1]})), True)
            self.modal = None
            return
        if isinstance(m, tuple) and m[0] == "msdetail":
            page = max(1, self.s.getmaxyx()[0] - 10)
            if k in (curses.KEY_UP, ord("k")):
                self.msd_top = max(0, self.msd_top - 1)
            elif k in (curses.KEY_DOWN, ord("j")):
                self.msd_top += 1
            elif k == curses.KEY_PPAGE:
                self.msd_top = max(0, self.msd_top - page)
            elif k == curses.KEY_NPAGE:
                self.msd_top += page
            elif k in (curses.KEY_HOME,):
                self.msd_top = 0
            elif k in (ESC, 10, 13, curses.KEY_ENTER, ord("q")):
                self.modal = None
            return
        if isinstance(m, tuple) and m[0] == "fpconfirm":
            if k in (ord("o"), ord("O"), ord("y"), ord("Y")) and self.cm is not None:
                r = m[1]
                self.cm.toggle(r["host"], r["rid"], r["msg"], scope_global=(m[2] == ""))
                self.flash = (time.monotonic(), "Règle %s : demande envoyée…" % r["rid"], True)
            self.modal = None
            return
        if isinstance(m, tuple) and m[0] == "filter":
            buf = m[1]
            if k in (10, 13, curses.KEY_ENTER):
                if self.view == "modsec":
                    self.ms_filter = buf.strip()
                    self.ms_cur = self.ms_top = 0
                else:
                    self.ban_filter = buf.strip()
                    self.ban_cur = self.ban_top = 0
                self.modal = None
            elif k == ESC:
                self.modal = None
            elif k in (curses.KEY_BACKSPACE, 127, 8):
                self.modal = ("filter", buf[:-1])
            elif 32 <= k < 127:
                self.modal = ("filter", buf + chr(k))
            return
        if m == "cols":
            cols = self.cfg["columns"]
            c = cols[self.col_cur]
            d = COLDEF[c["id"]]
            if k in (curses.KEY_UP, ord("k")):
                self.col_cur = (self.col_cur - 1) % len(cols)
            elif k in (curses.KEY_DOWN, ord("j")):
                self.col_cur = (self.col_cur + 1) % len(cols)
            elif k in (ord(" "), ord("x")):
                c["on"] = not c["on"]
                if not any(cc["on"] for cc in cols):
                    c["on"] = True
            elif k in (curses.KEY_RIGHT, ord("l"), ord("+")):
                c["width"] = d[2] if c["width"] == 0 else min(d[3], c["width"] + 1)
            elif k in (curses.KEY_LEFT, ord("h"), ord("-")):
                if c["id"] == "ip" and c["width"] <= d[2]:
                    c["width"] = 0
                elif c["width"]:
                    c["width"] = max(d[2], c["width"] - 1)
            elif k == ord("a") and c["id"] == "ip":
                c["width"] = 0
            elif k == ord("<") and self.col_cur > 0:
                i = self.col_cur
                cols[i - 1], cols[i] = cols[i], cols[i - 1]
                self.col_cur -= 1
            elif k == ord(">") and self.col_cur < len(cols) - 1:
                i = self.col_cur
                cols[i + 1], cols[i] = cols[i], cols[i + 1]
                self.col_cur += 1
            elif k == ord("d"):
                self.cfg["columns"] = default_columns()
            elif k in (10, 13, curses.KEY_ENTER, ESC, ord("q"), ord("c"), curses.KEY_F2):
                self.modal = None
                if self.cfg_path:
                    err = save_config(self.cfg_path, self.cfg_owner, self.cfg)
                    self.flash = (time.monotonic(), ("Colonnes enregistrées dans " + self.cfg_path) if not err
                                  else "Colonnes appliquées, mais non enregistrées : " + err, not err)

    def key(self, k):
        e = self.e
        if self.modal is not None:
            self.key_modal(k)
            return True
        if k in (ord("q"), ord("Q"), 3):
            return False
        order = ["dash", "bans", "modsec"]
        if k == 9:
            self.view = order[(order.index(self.view) + 1) % 3]
            return True
        if k == curses.KEY_BTAB:
            self.view = order[(order.index(self.view) - 1) % 3]
            return True
        if k == ord("1"):
            self.view = "dash"
            return True
        if k == ord("2"):
            self.view = "bans"
            return True
        if k == ord("3"):
            self.view = "modsec"
            return True
        if k in (ord("h"), ord("?")):
            self.modal = "help"
            return True
        if self.view == "bans":
            return self.key_bans(k)
        if self.view == "modsec":
            return self.key_modsec(k)
        if k in (ord("p"), ord(" ")):
            self.paused = not self.paused
        elif k in (ord("w"), ord("W")):
            self.win_idx = (self.win_idx + 1) % len(WINDOWS)
            e.set_window(WINDOWS[self.win_idx][1])
        elif k in (ord("b"), ord("B")):
            self.blocked_only = not self.blocked_only
            self.scroll = 0
        elif k in (ord("+"), ord("=")):
            self.set_scale(+1)
        elif k in (ord("-"), ord("_")):
            self.set_scale(-1)
        elif k in (ord("c"), ord("C"), curses.KEY_F2):
            self.modal = "cols"
            self.col_cur = 0
        elif k == ord("u"):
            self.view = "bans"
        elif k == ord("i"):
            self.mid_view = (self.mid_view + 1) % len(self.MID_VIEWS)
        elif k == ord("v"):
            self.right_view = (self.right_view + 1) % len(self.RIGHT_VIEWS)
        elif k in (ord("r"), ord("R")):
            e.reset()
            e.set_window(e.window_secs)
            self.scroll = 0
        elif k in (curses.KEY_UP, ord("k")):
            self._scroll(1)
        elif k in (curses.KEY_DOWN, ord("j")):
            self._scroll(-1)
        elif k == curses.KEY_PPAGE:
            self._scroll(10)
        elif k == curses.KEY_NPAGE:
            self._scroll(-10)
        elif k in (curses.KEY_HOME, ord("g")):
            self._scroll(10 ** 6)
        elif k in (curses.KEY_END, ord("G")):
            self.scroll = 0
        return True

    def key_bans(self, k):
        n = len(self.ban_rows)
        page = max(1, self.s.getmaxyx()[0] - 8)
        if k in (curses.KEY_UP, ord("k")):
            self.ban_cur = max(0, self.ban_cur - 1)
        elif k in (curses.KEY_DOWN, ord("j")):
            self.ban_cur = min(max(0, n - 1), self.ban_cur + 1)
        elif k == curses.KEY_PPAGE:
            self.ban_cur = max(0, self.ban_cur - page)
        elif k == curses.KEY_NPAGE:
            self.ban_cur = min(max(0, n - 1), self.ban_cur + page)
        elif k in (curses.KEY_HOME, ord("g")):
            self.ban_cur = 0
        elif k in (curses.KEY_END, ord("G")):
            self.ban_cur = max(0, n - 1)
        elif k in (ord("u"), curses.KEY_DC):
            self.ask_unban(False)
        elif k == ord("U"):
            self.ask_unban(True)
        elif k == ord("C"):
            if self.bm is None or self.bm.cs is None:
                self.flash = (time.monotonic(), "Unban CrowdSec indisponible (lancé avec --no-crowdsec)", False)
            else:
                self.cs_on = not self.cs_on
                self.cfg["crowdsec_unban"] = self.cs_on
                err = save_config(self.cfg_path, self.cfg_owner, self.cfg) if self.cfg_path else None
                self.flash = (time.monotonic(), ("Unban CrowdSec ACTIVÉ : u/U supprimeront aussi les décisions "
                                                 "(%s)" % self.bm.cs.label()) if self.cs_on else
                              "Unban CrowdSec désactivé : seuls les bans BunkerWeb seront levés"
                              + (" (non enregistré : %s)" % err if err else ""), True)
        elif k == ord("/"):
            self.modal = ("filter", self.ban_filter)
        elif k == ESC:
            self.ban_filter = ""
        elif k in (ord("s"), ord("S")):
            self.ban_sort = (self.ban_sort + 1) % len(self.BAN_SORTS)
            self.ban_cur = self.ban_top = 0
        elif k in (ord("r"), ord("R"), curses.KEY_F5):
            if self.bm is not None:
                self.bm.refresh()
                self.flash = (time.monotonic(), "Rafraîchissement des bans…", True)
        elif k in (ord("p"), ord(" ")):
            self.paused = not self.paused
        return True

    def key_modsec(self, k):
        n = len(self.ms_rows)
        page = max(1, self.s.getmaxyx()[0] - 8)
        if k in (curses.KEY_UP, ord("k")):
            self.ms_cur = max(0, self.ms_cur - 1)
        elif k in (curses.KEY_DOWN, ord("j")):
            self.ms_cur = min(max(0, n - 1), self.ms_cur + 1)
        elif k == curses.KEY_PPAGE:
            self.ms_cur = max(0, self.ms_cur - page)
        elif k == curses.KEY_NPAGE:
            self.ms_cur = min(max(0, n - 1), self.ms_cur + page)
        elif k in (curses.KEY_HOME,):
            self.ms_cur = 0
        elif k in (curses.KEY_END,):
            self.ms_cur = max(0, n - 1)
        elif k in (10, 13, curses.KEY_ENTER):
            if self.ms_rows:
                r = self.ms_rows[min(self.ms_cur, len(self.ms_rows) - 1)]
                self.msd_top = 0
                self.modal = ("msdetail", r["host"], r["rid"])
        elif k == ord("w"):
            self.ask_whitelist(scope_global=False)
        elif k == ord("g"):
            self.ask_whitelist(scope_global=True)
        elif k == ord("/"):
            self.modal = ("filter", self.ms_filter)
        elif k == ESC:
            self.ms_filter = ""
        elif k in (ord("s"), ord("S")):
            self.ms_sort = (self.ms_sort + 1) % len(self.MS_SORTS)
            self.ms_cur = self.ms_top = 0
        elif k in (ord("r"), ord("R"), curses.KEY_F5):
            if self.cm is not None:
                self.cm.refresh()
                self.flash = (time.monotonic(), "Rafraîchissement des exclusions…", True)
        elif k in (ord("p"), ord(" ")):
            self.paused = not self.paused
        return True

    def _scroll(self, d):
        if self.scroll == 0 and d > 0:
            self.anchor = self.e.seq
        cur = self.scroll + ((self.e.seq - self.anchor) if self.scroll > 0 else 0)
        new = max(0, cur + d)
        self.scroll = new
        self.anchor = self.e.seq


# Sequences que certains terminaux envoient meme quand terminfo ne les decrit pas
# (TERM incorrect, tmux/screen, client SSH) : on les decode nous-memes.
RAW_KEYS = {"[A": curses.KEY_UP, "[B": curses.KEY_DOWN, "[C": curses.KEY_RIGHT, "[D": curses.KEY_LEFT,
            "OA": curses.KEY_UP, "OB": curses.KEY_DOWN, "OC": curses.KEY_RIGHT, "OD": curses.KEY_LEFT,
            "[H": curses.KEY_HOME, "[F": curses.KEY_END, "OH": curses.KEY_HOME, "OF": curses.KEY_END,
            "[1~": curses.KEY_HOME, "[4~": curses.KEY_END, "[7~": curses.KEY_HOME, "[8~": curses.KEY_END,
            "[5~": curses.KEY_PPAGE, "[6~": curses.KEY_NPAGE, "[3~": curses.KEY_DC, "[Z": curses.KEY_BTAB,
            "OQ": curses.KEY_F2, "[12~": curses.KEY_F2, "[15~": curses.KEY_F5}


def read_key(scr):
    k = scr.getch()
    if k != ESC:
        return k
    scr.nodelay(True)
    seq = ""
    try:
        while len(seq) < 5:
            c = scr.getch()
            if c == -1 or not 0 <= c < 256:
                break
            seq += chr(c)
            if seq in RAW_KEYS:
                return RAW_KEYS[seq]
            if seq[0] not in "[O" or (len(seq) > 1 and (seq[-1].isalpha() or seq[-1] == "~")):
                break
    finally:
        scr.nodelay(False)
    for c in reversed(seq):                    # sequence inconnue : on rend les caracteres
        curses.ungetch(ord(c))
    return ESC


def run(scr, eng, source_label, color, bans, cfg, cfg_path, cfg_owner, configmgr):
    curses.set_escdelay(25) if hasattr(curses, "set_escdelay") else None
    ui = UI(scr, eng, source_label, color, bans, cfg, cfg_path, cfg_owner, configmgr)
    last = 0.0
    dirty = True
    while True:
        eng.pump()
        scr.timeout(15 if not eng.q.empty() else 120)
        k = read_key(scr)
        if k != -1:
            if k == curses.KEY_RESIZE:
                dirty = True
            elif not ui.key(k):
                return
            else:
                dirty = True
        now = time.time()
        if (dirty or now - last >= 0.5) and (not ui.paused or dirty):
            ui.draw()
            last, dirty = now, False


