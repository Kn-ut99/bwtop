class BanManager:
    def __init__(self, client, interval=5.0, cs=None):
        self.client, self.interval = client, max(1.0, interval)
        self.cs = cs
        self.bans, self.err, self.ok_at = [], None, 0.0
        self.banned = set()
        self.loading = True
        self.last = None
        self.actions = queue.Queue()
        self.wake = threading.Event()
        self.msgs = collections.deque(maxlen=20)        # (monotonic, texte, ok)

    def refresh(self):
        self.wake.set()

    def unban(self, bans, cs_ips=()):
        self.actions.put((list(bans), list(cs_ips)))
        self.wake.set()

    def _say(self, txt, ok):
        self.msgs.append((time.monotonic(), txt, ok))
        self.last = (time.monotonic(), txt, ok)

    def _do(self, bans, cs_ips):
        cs_ok = set()
        for ip in cs_ips:                           # 1) decisions CrowdSec (comme BunkerWeb : avant la copie locale)
            try:
                n = self.cs.delete(ip)
                left = [d for d in self.cs.decisions(ip) if d["type"] == "ban"]
                if left:
                    self._say("✘ %s : %d décision(s) CrowdSec « ban » encore actives (%s)" % (
                        ip, len(left), ", ".join(sorted({d["origin"] for d in left}))), False)
                    continue
                cs_ok.add(ip)
                self._say("✔ %s : %s décision(s) CrowdSec supprimée(s)" % (ip, "?" if n is None else n), True)
            except BanError as e:
                self._say("✘ CrowdSec %s : %s" % (ip, e), False)
            except Exception as e:
                self._say("✘ CrowdSec %s : %s" % (ip, e), False)
        for b in bans:                              # 2) bans BunkerWeb
            where = "global" if b["scope"] == "global" else "site " + b["service"]
            try:
                if b["kind"] == "crowdsec_lease":
                    if b["ip"] not in cs_ok:
                        self._say("✘ %s (%s) : copie CrowdSec conservée, décisions non supprimées" % (b["ip"], where),
                                  False)
                        continue
                    self.client.remove_lease(b)
                    self._say("✔ %s : ban CrowdSec retiré de BunkerWeb (%s)" % (b["ip"], where), True)
                else:
                    self.client.unban(b)
                    self._say("✔ %s débanni (%s)" % (b["ip"], where), True)
            except BanError as e:
                self._say("✘ unban %s (%s) : %s" % (b["ip"], where, e), False)
            except Exception as e:
                self._say("✘ unban %s : %s" % (b["ip"], e), False)

    def _fetch(self):
        try:
            bans = self.client.list()
            self.bans, self.err, self.ok_at = bans, None, time.monotonic()
            self.banned = {b["ip"] for b in bans}
        except BanError as e:
            self.err = str(e)
        except Exception as e:                           # ne jamais tuer le thread
            self.err = "%s: %s" % (type(e).__name__, e)
        self.loading = False

    def run(self, stop):
        last = 0.0
        while not stop.is_set():
            did = False
            try:
                while True:
                    bans, cs_ips = self.actions.get_nowait()
                    did = True
                    self._do(bans, cs_ips)
            except queue.Empty:
                pass
            if did or self.wake.is_set() or time.monotonic() - last >= self.interval:
                self.wake.clear()
                self._fetch()
                last = time.monotonic()
            self.wake.wait(0.3)


# --------------------------------------------------------------------------- #
#  Exclusions ModSecurity (whitelist de faux positifs, par $host)
# --------------------------------------------------------------------------- #
#
# Deux mecanismes BunkerWeb open source, tous deux reversibles :
#   * API de controle bunkerweb-api  -> POST /configs type "modsec" : applique
#     automatiquement par le scheduler (flag custom_configs_changed), 100 % live.
#   * fichier /etc/bunkerweb/configs/modsec[/<service>]/<nom>.conf (bwtop en root)
#     ingere par le scheduler sur reload (SIGHUP). On lance donc le reload.
#
# Dans les deux cas on ecrit "SecRuleRemoveById <id>;", place APRES le Core Rule
# Set (type "modsec"), ce qui desactive la regle pour le service vise. Le nom du
# fichier/config porte le prefixe bwtop_fp_ pour pouvoir les lister et les retirer.

EXCL_PREFIX = "bwtop_fp_"
MODSEC_DIR = "/etc/bunkerweb/configs/modsec"
RESERVED_SVC = {"", "global", "unknown", "bwcli", "Web UI", "default server", "_"}
CUSTOM_CONFIG_DIRS_HINT = ("modsec", "modsec_crs", "http", "server_http", "default_server_http",
                           "stream", "server_stream")


class ConfigError(Exception):
    pass


def sanitize_token(s):
    return re.sub(r"[^\w-]", "_", s or "")[:200]


def excl_name(rid, service):
    return "%s%s_%s" % (EXCL_PREFIX, rid, sanitize_token(service) or "global")


def excl_data(rid, service, msg=""):
    scope = service or "global"
    body = ("# bwtop : exclusion de faux positif ModSecurity\n"
            "# règle %s désactivée pour %s%s\n"
            "SecRuleRemoveById %s;\n") % (rid, scope, (" — " + msg) if msg else "", rid)
    return body


def parse_excl_rid(name):
    if not name.startswith(EXCL_PREFIX):
        return None
    rest = name[len(EXCL_PREFIX):]
    m = re.match(r"(\d+)", rest)
    return m.group(1) if m else None


class ApiConfigBackend:
    """Exclusions via le plan de controle bunkerweb-api (POST/GET/DELETE /configs)."""
    kind = "api"
    live_note = "appliqué automatiquement par le scheduler en quelques secondes"

    def __init__(self, transport):
        self.t = transport              # BanClient (kind "central") : ._req(method, path, body)
        self._smap = None

    def label(self):
        return self.t.url + " · bunkerweb-api"

    def _call(self, method, path, body=None):
        try:
            return self.t._req(method, path, body)
        except BanError as e:
            raise ConfigError(str(e))

    def services(self):
        if self._smap is None:
            _, js = self._call("GET", "/services")
            rows = js.get("services") if isinstance(js, dict) else js
            ids, amap = set(), {}
            for s in rows or []:
                if not isinstance(s, dict):
                    continue
                sid = s.get("id") or s.get("name")
                if not sid:
                    continue
                ids.add(sid)
                amap[sid] = sid
                for key in ("SERVER_NAME", "server_name", sid + "_SERVER_NAME"):
                    v = s.get(key)
                    if isinstance(v, str):
                        for tok in v.split():
                            amap.setdefault(tok, sid)
            self._smap = (ids, amap)
        return self._smap

    def resolve_service(self, host):
        try:
            ids, amap = self.services()
        except ConfigError:
            return host, "unknown"
        if host in amap:
            return amap[host], "ok"
        return host, "unmatched"

    def list_services(self):
        return sorted(self.services()[0])

    def service_modsec(self, service):
        """True/False si ModSec est activé sur le service, None si indéterminé."""
        try:
            _, js = self._call("GET", "/services/%s?full=true&methods=false" % service)
        except ConfigError:
            return None
        conf = js.get("config") if isinstance(js, dict) else None
        if not isinstance(conf, dict):
            return None
        v = conf.get("USE_MODSECURITY")
        if isinstance(v, dict):
            v = v.get("value")
        return (str(v).lower() == "yes") if v is not None else True

    def list_exclusions(self):
        _, js = self._call("GET", "/configs?type=modsec&with_data=false")
        items = js if isinstance(js, list) else js.get("configs") or js.get("data") or []
        out = []
        for it in items:
            if not isinstance(it, dict):
                continue
            name = it.get("name", "")
            rid = parse_excl_rid(name)
            if not rid:
                continue
            svc = it.get("service") or it.get("service_id") or "global"
            out.append({"rid": rid, "service": "" if svc in RESERVED_SVC else svc, "name": name})
        return out

    def add(self, service, rid, msg="", reload_after=True):
        body = {"type": "modsec", "name": excl_name(rid, service),
                "data": excl_data(rid, service, msg), "service": service or "global"}
        try:
            self._call("POST", "/configs", body)
        except ConfigError as e:
            if "already exists" in str(e).lower():
                return
            raise

    def remove(self, excl, reload_after=True):
        svc = excl["service"] or "global"
        self._call("DELETE", "/configs/%s/modsec/%s" % (svc, excl["name"]))

    def apply(self):
        return None             # le scheduler applique tout seul


class FileConfigBackend:
    """Exclusions par fichiers .conf (bwtop en root), ingérées au reload du scheduler."""
    kind = "file"
    live_note = "bwtop recharge le scheduler juste après (systemctl reload)"

    def __init__(self, base=MODSEC_DIR, reload_cmd=None, env=None):
        self.base = base
        self.reload_cmd = reload_cmd or ["systemctl", "restart", "bunkerweb-scheduler"]
        self.env = env or {}

    def label(self):
        return self.base + " · reload: " + " ".join(self.reload_cmd)

    def _path(self, service, rid):
        name = excl_name(rid, service) + ".conf"
        return os.path.join(self.base, service, name) if service else os.path.join(self.base, name)

    def _service_map(self):
        # Carte alias -> service (= identifiant = premier server_name). On lit le SERVER_NAME
        # global (noms principaux) ET chaque <service>_SERVER_NAME (qui liste les alias), car en
        # multisite le nom vu dans les logs est souvent un alias absent du SERVER_NAME global.
        amap, ids = {}, set()
        for tok in (self.env.get("SERVER_NAME") or "").split():
            ids.add(tok)
            amap.setdefault(tok, tok)
        for key, val in self.env.items():
            if key.endswith("_SERVER_NAME") and isinstance(val, str):
                primary = key[:-len("_SERVER_NAME")]
                toks = val.split()
                sid = primary if primary in ids or not toks else toks[0]
                ids.add(sid)
                for tok in toks:
                    amap.setdefault(tok, sid)
        # Dossiers de services déjà présents sous configs/ (source additionnelle fiable)
        try:
            parent = os.path.dirname(self.base)
            for d in CUSTOM_CONFIG_DIRS_HINT:
                sub = os.path.join(parent, d)
                if os.path.isdir(sub):
                    for name in os.listdir(sub):
                        if os.path.isdir(os.path.join(sub, name)):
                            ids.add(name)
                            amap.setdefault(name, name)
        except OSError:
            pass
        return ids, amap

    def resolve_service(self, host):
        ids, amap = self._service_map()
        if host in amap:
            return amap[host], "ok"
        return host, ("unmatched" if amap else "unknown")

    def list_services(self):
        return sorted(self._service_map()[0])

    def service_modsec(self, service):
        v = self.env.get("%s_USE_MODSECURITY" % service) or self.env.get("USE_MODSECURITY") or "yes"
        return str(v).lower() == "yes"

    def list_exclusions(self):
        out = []
        try:
            for root, _, files in os.walk(self.base):
                for fn in files:
                    if not (fn.startswith(EXCL_PREFIX) and fn.endswith(".conf")):
                        continue
                    rid = parse_excl_rid(fn[:-5])
                    if not rid:
                        continue
                    svc = "" if os.path.dirname(os.path.join(root, fn)) == self.base else os.path.basename(root)
                    out.append({"rid": rid, "service": svc, "name": fn[:-5], "path": os.path.join(root, fn)})
        except OSError as e:
            raise ConfigError("lecture de %s impossible : %s" % (self.base, e))
        return out

    def add(self, service, rid, msg="", reload_after=True):
        path = self._path(service, rid)
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            tmp = path + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                f.write(excl_data(rid, service, msg))
            os.replace(tmp, path)
        except OSError as e:
            raise ConfigError("écriture de %s impossible : %s (lancer bwtop en root ?)" % (path, e))
        if reload_after:
            self.apply()

    def remove(self, excl, reload_after=True):
        path = excl.get("path") or self._path(excl["service"], excl["rid"])
        try:
            os.remove(path)
        except FileNotFoundError:
            pass
        except OSError as e:
            raise ConfigError("suppression de %s impossible : %s" % (path, e))
        if reload_after:
            self.apply()

    def apply(self):
        try:
            p = subprocess.run(self.reload_cmd, capture_output=True, text=True, timeout=60)
        except (OSError, subprocess.TimeoutExpired) as e:
            raise ConfigError("reload du scheduler impossible (%s) : %s — relance-le à la main" % (
                " ".join(self.reload_cmd), e))
        if p.returncode != 0:
            err = ANSI_RE.sub("", (p.stderr or p.stdout or "")).strip().splitlines()
            raise ConfigError("reload du scheduler a échoué (code %d) : %s" % (
                p.returncode, err[-1][:160] if err else ""))
        return None


