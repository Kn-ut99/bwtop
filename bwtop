            msg = "Aucun ban actif." if not self.ban_filter else "Aucun ban ne correspond au filtre."
            self.put(list_y + 1, 3, msg, curses.A_DIM)
            return
        self.ban_cur = max(0, min(self.ban_cur, len(rows) - 1))
        if self.ban_cur < self.ban_top:
            self.ban_top = self.ban_cur
        if self.ban_cur >= self.ban_top + nrows:
            self.ban_top = self.ban_cur - nrows + 1
        self.ban_top = max(0, min(self.ban_top, max(0, len(rows) - nrows)))
        for i in range(nrows):
            idx = self.ban_top + i
            if idx >= len(rows):
                break
            b = rows[idx]
            sel = idx == self.ban_cur
            base = curses.A_REVERSE if sel else 0
            yy = list_y + i
            if sel:
                self.put(yy, 1, " " * (w - 2), base)
            scope = "global" if b["scope"] == "global" else ("default server" if b["service"] == "_" else b["service"])
            when = datetime.fromtimestamp(b["date"]).strftime("%d/%m %H:%M:%S") if b["date"] >= 1 else "-"
