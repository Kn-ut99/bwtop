            self.ranked(y, w1, mid_h, w2, t2, top(getattr(e, a2), rows),
                        colors=lambda k, i: C_BAD if a2 == "c_bip" else C_OK, right=right2, is_ip=True)
            t3, a3 = self.RIGHT_VIEWS[self.right_view]
            self.ranked(y, w1 + w2, mid_h, w3, t3, top(getattr(e, a3), rows),
                        colors=lambda k, i: C_MAG if a3 == "c_rule" else C_TITLE, right="[v]")
            y += mid_h

        self.draw_feed(y, feed_h, w)

    def draw_graph(self, y, x, gw, rq, bl):
        """Barres empilees sur GRAPH_ROWS lignes : bloquees (rouge) en bas, autorisees (vert) au-dessus."""
        if self.gmax is None:                          # calibrage unique au demarrage, puis echelle figee
            if time.monotonic() - self.t0 < 2.0:
                self.put(y + 1, x + 8, "calibrage de l'échelle…", curses.A_DIM)
                return
            self.gmax = nice_scale(max(rq + [0.0]) * 1.25 or 1)
        gm = float(self.gmax)
        units = GRAPH_ROWS * 8
        labels = {0: fmt_rate(gm), GRAPH_ROWS // 2: fmt_rate(gm / 2), GRAPH_ROWS - 1: "0"}
        for r in range(GRAPH_ROWS):
            self.put(y + r, x, labels.get(r, "").rjust(5), curses.A_DIM)
            self.put(y + r, x + 5, "┤" if r in labels else "│", curses.A_DIM)
        bx = x + 7
        off = max(0, gw - len(rq))                     # plus recent a droite
        for i, (r, b) in enumerate(zip(rq[-gw:], bl[-gw:])):
            if r <= 0:
                continue
            tu = max(1, int(round(min(r, gm) / gm * units)))
            bu = int(round(min(b, r, gm) / gm * units))
            if b > 0:
                bu = max(1, min(bu, tu))
            clipped = r > gm
            cx = bx + off + i
            for row in range(GRAPH_ROWS):             # row 0 = bas
                fill = max(0, min(8, tu - row * 8))
                if not fill:
                    break
                red = max(0, min(8, bu - row * 8))
                if red >= fill:                        # case entierement bloquee
                    ch, a = SPARK[fill], self.attr[C_BAD]
                elif red == 0:                         # case entierement autorisee
                    ch, a = SPARK[fill], self.attr[C_OK]
                elif fill == 8:                        # frontiere : bas rouge, haut vert (fond)
                    ch, a = SPARK[red], self.attr[C_STACK]
                else:                                  # sommet partiel mixte : couleur majoritaire
                    ch, a = SPARK[fill], self.attr[C_BAD] if red * 2 >= fill else self.attr[C_OK]
                if clipped and row == GRAPH_ROWS - 1:
                    ch, a = "▲", self.attr[C_WARN] | curses.A_BOLD
                self.put(y + GRAPH_ROWS - 1 - row, cx, ch, a, 1)

    def set_scale(self, d):
        cur = self.gmax or 1
        i = min(range(len(SCALES)), key=lambda k: abs(SCALES[k] - cur))
        self.gmax = SCALES[max(0, min(len(SCALES) - 1, i + d))]
        self.cfg["graph_max"] = self.gmax
        err = save_config(self.cfg_path, self.cfg_owner, self.cfg) if self.cfg_path else None
        self.flash = (time.monotonic(), "Échelle du graphe : 0 – %s req/s%s" % (
            fmt_rate(self.gmax), (" (non enregistrée : %s)" % err) if err else " (enregistrée)"), not err)

    # -- flux : colonnes configurables -------------------------------------------
    def ip_width(self, ips):
        cur, ts = self._ipw
        new = max([len(i) for i in ips] + [7])
        now = time.monotonic()
        if new >= cur or now - ts > 30:               # s'elargit tout de suite, retrecit lentement
            self._ipw = (new, now)
            return new
        return cur

    def feed_layout(self, iw, evs):
        cols = [c for c in self.cfg["columns"] if c["on"]]
        if not self.e.seen_host:
            cols = [c for c in cols if c["id"] != "host"] or cols
        if not cols:
            cols = [{"id": "url", "on": True, "width": 40}]
        widths = []
        for c in cols[:-1]:
            wd = c["width"]
            if c["id"] == "ip" and wd == 0:
                wd = min(39, self.ip_width([ev.ip for ev in evs]))
            widths.append(wd)
        last_min = COLDEF[cols[-1]["id"]][2]
        rem = iw - sum(widths) - len(widths)
        if rem < last_min:                              # on retrecit les colonnes elastiques
            deficit = last_min - rem
            for cid in ("ua", "reason", "url", "host"):
                for i, c in enumerate(cols[:-1]):
                    if c["id"] == cid and deficit > 0:
                        cut = min(deficit, max(0, widths[i] - COLDEF[cid][2]))
                        widths[i] -= cut
                        deficit -= cut
            rem = iw - sum(widths) - len(widths)
        widths.append(max(1, rem))
        return list(zip([c["id"] for c in cols], widths))

    def cell(self, cid, ev):
        """(texte, attribut, coupe_au_milieu, aligne_a_droite)"""
        if cid == "time":
            return datetime.fromtimestamp(ev.ts).strftime("%H:%M:%S"), curses.A_DIM, False, False
        if cid == "ip":
            a = self.attr[C_BAD] | curses.A_BOLD if self.banned(ev.ip) else 0
            return ev.ip, a, True, False
        if cid == "code":
            col = C_OK if ev.status < 300 else C_INFO if ev.status < 400 else C_WARN if ev.status < 500 else C_BAD
            if ev.blocked:
                col = C_BAD
            return str(ev.status), self.attr[col] | curses.A_BOLD, False, False
        if cid == "reason":
            rc = REASON_COLOR.get(ev.reason, C_WARN) if ev.blocked else 0
            return self.e.reason_of(ev), (self.attr[rc] if rc else 0), False, False
        if cid == "host":
            return ev.host, self.attr[C_TITLE], False, False
        if cid == "method":
            return ev.method, curses.A_DIM, False, False
        if cid == "size":
            return fmt_b(ev.size), curses.A_DIM, False, True
        if cid == "ua":
            return ev.ua, curses.A_DIM, False, False
        return ev.path, 0, False, False

    def draw_feed(self, y, fh, w):
        e = self.e
        title = "Requêtes en direct" + (" — bloquées seulement" if self.blocked_only else "")
        self.box(y, 0, fh, w, title, ("↑↓ défiler" if self.scroll else "live") + " · c colonnes")
        iw, rows = w - 4, fh - 3
        src = e.blocked_events if self.blocked_only else e.events
        off = self.scroll + ((e.seq - self.anchor) if self.scroll > 0 else 0)
        n = len(src)
        off = max(0, min(off, max(0, n - rows)))
        evs = []
        for i in range(rows):
            idx = n - 1 - off - i
            if idx < 0:
                break
            evs.append(src[idx])
        layout = self.feed_layout(iw, evs)
        x = 2
        for cid, wd in layout:
            self.put(y + 1, x, COLDEF[cid][0].ljust(wd), curses.A_BOLD | curses.A_UNDERLINE, wd)
            x += wd + 1
        for i, ev in enumerate(evs):
            yy = y + 2 + i
            x = 2
            for cid, wd in layout:
                txt, a, mid, right = self.cell(cid, ev)
                txt = elide(txt, wd, mid)
                self.put(yy, x, txt.rjust(wd) if right else txt.ljust(wd), a, wd)
                x += wd + 1

    # -- vue Bans -------------------------------------------------------------------
    def compute_ban_rows(self):
        if self.bm is None:
            return []
        rows = list(self.bm.bans)
        f = self.ban_filter.lower()
        if f:
            rows = [b for b in rows if f in b["ip"].lower() or f in b["service"].lower()
                    or f in b["reason"].lower() or f in b["country"].lower()]
        now = time.monotonic()
        for b in rows:
            b["hits"] = self.e.c_bip.get(b["ip"], 0)
            b["left"] = None if b["permanent"] else max(0.0, b["exp"] - (now - b["at"]))
        key = self.BAN_SORTS[self.ban_sort][0]
        if key == "date":
            rows.sort(key=lambda b: -b["date"])
        elif key == "hits":
            rows.sort(key=lambda b: (-b["hits"], -b["date"]))
        elif key == "remaining":
            rows.sort(key=lambda b: float("inf") if b["left"] is None else b["left"])
        else:
            rows.sort(key=lambda b: (b["ip"], b["scope"], b["service"]))
        return rows

    # -- vue ModSec (tuning des faux positifs) --------------------------------------
    MS_SORTS = [("count", "nb déclenchements"), ("recent", "plus récents"),
                ("host", "host"), ("rule", "règle")]

    def compute_ms_rows(self):
        rows = []
        f = self.ms_filter.lower()
        now = time.monotonic()
        for (host, rid), hdef in self.e.modsec.items():
            if f and not (f in host.lower() or f in rid or f in hdef["msg"].lower()
                          or f in hdef["uri"].lower()):
                continue
            excl = self.cm is not None and self.cm.excluded(host, rid)
            rows.append({"host": host, "rid": rid, "msg": hdef["msg"], "count": hdef["count"],
                         "ips": len(hdef["ips"]), "uri": hdef["uri"], "last": hdef["last"], "excl": excl})
        key = self.MS_SORTS[self.ms_sort][0]
        if key == "count":
            rows.sort(key=lambda r: (-r["count"], -r["last"]))
        elif key == "recent":
            rows.sort(key=lambda r: -r["last"])
        elif key == "host":
            rows.sort(key=lambda r: (r["host"], r["rid"]))
        else:
            rows.sort(key=lambda r: (r["rid"], r["host"]))
        return rows

    def draw_modsec(self, y, h, w):
        rows = self.ms_rows = self.compute_ms_rows()
        nexcl = len(self.cm.exclusions) if (self.cm and not self.cm.err) else None
        right = "tri : %s" % self.MS_SORTS[self.ms_sort][1]
        if self.ms_filter:
            right = "filtre « %s » · " % self.ms_filter + right
        self.box(y, 0, h, w, "ModSecurity — déclenchements & faux positifs", right)
        iw = w - 4
        if self.cm is not None:
            info = "Exclusions : %s" % self.cm.backend.label()
            if nexcl is not None:
                info += "   ·   %d règle(s) whitelistée(s)" % nexcl
        else:
            info = "Whitelist désactivée (--no-exclusions) : affichage seul"
        self.put(y + 1, 2, info, curses.A_DIM, iw)
        top_y = y + 2
        if self.cm is not None and self.cm.err:
            self.put(top_y, 2, "⚠ liste : " + self.cm.err, self.attr[C_BAD] | curses.A_BOLD, iw)
            top_y += 1
        if self.cm is not None and self.cm.last is not None:
            _, ltxt, lok = self.cm.last
            self.put(top_y, 2, ("dernière action : " + ltxt)[:iw],
                     (self.attr[C_OK] if lok else self.attr[C_BAD]) | curses.A_BOLD, iw)
            top_y += 1
        hostw = min(26, max(8, max([len(r["host"]) for r in rows] + [8]))) if rows else 12
        cols = [("", 1), ("HOST", hostw), ("RÈGLE", 7), ("REQ", 6), ("IPs", 5), ("DERNIER", 9)]
        rest = iw - sum(wd for _, wd in cols) - len(cols)
        cols.append(("MESSAGE / URI", max(12, rest)))
        x = 2
        for name, wd in cols:
            self.put(top_y, x, name.ljust(wd), curses.A_BOLD | curses.A_UNDERLINE, wd)
            x += wd + 1
        list_y = top_y + 1
        nrows = y + h - 1 - list_y
        if not rows:
            msg = ("Aucun déclenchement ModSecurity capté pour l'instant." if not self.ms_filter
                   else "Aucun déclenchement ne correspond au filtre.")
            self.put(list_y + 1, 3, msg, curses.A_DIM)
            self.put(list_y + 3, 3, "Les règles CRS qui bloquent apparaîtront ici dès qu'elles se déclenchent.",
                     curses.A_DIM)
            return
        self.ms_cur = max(0, min(self.ms_cur, len(rows) - 1))
        if self.ms_cur < self.ms_top:
            self.ms_top = self.ms_cur
        if self.ms_cur >= self.ms_top + nrows:
            self.ms_top = self.ms_cur - nrows + 1
        self.ms_top = max(0, min(self.ms_top, max(0, len(rows) - nrows)))
        now = time.monotonic()
        for i in range(nrows):
            idx = self.ms_top + i
            if idx >= len(rows):
                break
            r = rows[idx]
            sel = idx == self.ms_cur
            base = curses.A_REVERSE if sel else 0
            yy = list_y + i
            if sel:
                self.put(yy, 1, " " * (w - 2), base)
            ago = fmt_dur(max(0, now - r["last"])) if r["last"] else "-"
            msg = r["msg"] or "-"
            if r["uri"]:
                msg += "  —  " + r["uri"]
            host = r["host"] or "(global)"
            vals = {"": ("✔" if r["excl"] else "", self.attr[C_OK] | curses.A_BOLD),
                    "HOST": (host, self.attr[C_TITLE]),
                    "RÈGLE": (r["rid"], curses.A_BOLD),
                    "REQ": (fmt_n(r["count"]), curses.A_BOLD),
                    "IPs": (fmt_n(r["ips"]), curses.A_DIM),
                    "DERNIER": (ago, curses.A_DIM),
                    "MESSAGE / URI": (msg, self.attr[C_MAG] if not r["excl"] else curses.A_DIM)}
            x = 2
            for name, wd in cols:
                txt, a = vals[name]
                txt = elide(txt, wd, middle=(name == "HOST"))
                txt = txt.rjust(wd) if name in ("REQ", "IPs", "DERNIER") else txt.ljust(wd)
