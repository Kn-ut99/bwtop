class BwcliUnban:
    """Unban via `bwcli unban` (gere aussi le multi-instances), liste via l'API."""

    def __init__(self, lister, prefix=()):
        self.lister, self.prefix = lister, list(prefix)

    def label(self):
        return self.lister.label() + " · unban via bwcli"

    def list(self):
