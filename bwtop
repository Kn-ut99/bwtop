    for svc in services:
        try:
            st = backend.service_modsec(svc)
        except Exception:
            st = None
        tag = "ModSec ON " if st is True else ("ModSec OFF" if st is False else "ModSec ?  ")
        on += 1 if st is True else 0
        print("        %-36s %s" % (svc, tag))
    line(None, "ModSec actif sur %d/%d service(s) détecté(s)" % (on, len(services)))


def selftest(args):
    """Diagnostic complet : vérifie tous les prérequis de bwtop et teste l'application ModSec sur tous les services."""
    problems = [0]

    def line(ok, txt):
        if ok is False:
            problems[0] += 1
        mark = "  OK " if ok is True else ("  !! " if ok is False else "     ")
        print(mark + txt)

    def section(name):
        print("\n[%s]" % name)

    print("bwtop %s — diagnostic complet\n" % VERSION)

    # --- Environnement -------------------------------------------------------
    section("Environnement")
    euid = os.geteuid() if hasattr(os, "geteuid") else -1
    line(euid == 0 if euid >= 0 else None,
         "utilisateur : uid=%d%s" % (euid, "  (root)" if euid == 0 else "  (PAS root — logs et configs peuvent être inaccessibles)"))
    try:
        import curses as _c
        for d in TERMINFO_PATHS:
            if os.path.isdir(d):
                break
        _c.setupterm(term=os.environ.get("TERM") or "xterm-256color", fd=1)
        line(True, "terminal / terminfo : OK (TERM=%s)" % (os.environ.get("TERM") or "xterm-256color"))
    except Exception as e:
        line(False, "terminfo : %s — installe ncurses-base/ncurses-term" % e)
    env, read = read_env_files()
    line(bool(read), "variables.env : %s" % (", ".join(read) if read else "AUCUN (droits ? install non standard ?)"))

    # --- Sources de logs -----------------------------------------------------
    section("Sources de logs (dashboard)")
    if args.demo:
        line(None, "mode --demo : trafic synthétique, pas de logs réels.")
    elif args.source == "-":
        line(None, "mode stdin : les logs arrivent par un pipe.")
    elif args.docker:
        import shutil
        line(bool(shutil.which("docker")), "mode docker : conteneur « %s » via `docker logs`%s"
             % (args.docker, "" if shutil.which("docker") else " — `docker` introuvable"))
    else:
        for lab, path in (("access.log (trafic)", args.access), ("error.log (raisons/ModSec)", args.error)):
            ok = os.access(path, os.R_OK)
            line(ok, "%s : %s%s" % (lab, path, "" if ok else "  INTROUVABLE/illisible"))

    # --- Bans ----------------------------------------------------------------
    section("Bans")
    if args.no_bans:
        line(None, "désactivé (--no-bans).")
    else:
        try:
            client = build_ban_client(args, None)
            lbl = client.label() if client else "?"
            bans = client.list()
            line(True, "API bans joignable (%s) : %d ban(s) actif(s)" % (lbl, len(bans)))
        except BanError as e:
            line(False, "API bans injoignable : %s" % e)
        except Exception as e:
            line(False, "bans : %s" % e)
        if not args.no_crowdsec and not args.demo:
            import shutil
            exe = (args.cscli or "cscli").split()[0]
            ok = bool(shutil.which(exe) or os.path.exists(exe))
            line(ok, "cscli (unban CrowdSec) : %s%s" % (args.cscli, "" if ok else "  introuvable (--cscli ? sinon ignore)"))

    # --- Exclusions ModSecurity ---------------------------------------------
    section("Exclusions ModSecurity (faux positifs)")
    if args.no_fp_config:
        line(None, "désactivé (--no-exclusions).")
        print()
        print("Résumé : %d problème(s) détecté(s)." % problems[0] if problems[0] else "Résumé : tout est OK.")
        return 1 if problems[0] else 0
    _, _, src = resolve_api(args)
    backend = build_config_backend(args, None)
    if isinstance(backend, ApiConfigBackend):
        line(bool(src), "backend : API bunkerweb-api (%s) — token %s" % (backend.t.url, ("trouvé via %s" % src) if src else "ABSENT"))
        try:
            services = backend.list_services()
            line(True, "services connus de l'API : %d" % len(services))
            _list_services_modsec(backend, services, line)
        except Exception as e:
            line(False, "GET /services a échoué : %s" % e)
            services = []
    elif isinstance(backend, FileConfigBackend):
        line(None, "backend : FICHIER %s + « %s » (pas de token API → repli fichier)"
             % (backend.base, " ".join(backend.reload_cmd)))
        probe = os.path.join(backend.base, "bwtop_selftest_w.conf")
        try:
            os.makedirs(backend.base, exist_ok=True)
            with open(probe, "w", encoding="utf-8") as f:
                f.write("# test\n")
            os.remove(probe)
            line(True, "écriture dans %s : OK" % backend.base)
        except OSError as e:
            line(False, "écriture dans %s IMPOSSIBLE : %s%s" % (backend.base, e, "" if euid == 0 else "  (lance avec sudo)"))
        import shutil
        exe = backend.reload_cmd[0]
        line(bool(shutil.which(exe) or os.path.exists(exe)),
             "commande de reload : %s" % " ".join(backend.reload_cmd))
        services = backend.list_services()
        line(bool(services), "services détectés : %d%s" % (len(services), "" if services else "  (aucun — config en base ? test en global)"))
        _list_services_modsec(backend, services, line)
    else:
        line(None, "backend : simulation (--demo)")
        services = backend.list_services()

    # Test réel sur TOUS les services détectés (+ global)
    if not args.no_apply_test:
        targets = list(services)
        if "" not in targets:
            targets = targets + [""]                 # on teste aussi la portée globale
        print("\n— application réelle sur %d cible(s) (témoin inoffensif, puis nettoyage) —" % len(targets))
        probe_data = ("# bwtop selftest — témoin ; retire une règle inexistante (sans effet réel)\n"
                      "SecRuleRemoveById 2147483646;\n")
        try:
            if isinstance(backend, ApiConfigBackend):
                okc, tot = _probe_services_api(backend, targets, line, "bwtop_selftest", probe_data)
            elif isinstance(backend, FileConfigBackend):
                okc, tot = _probe_services_file(backend, targets, line, "bwtop_selftest", probe_data)
            else:
                line(None, "mode démo : application simulée, pas de test réel")
                okc = tot = len(targets)
            line(okc == tot, "bilan application : %d/%d cible(s) OK" % (okc, tot))
        except Exception as e:
            line(False, "test d'application interrompu : %s" % e)
    else:
        line(None, "test d'application ignoré (--no-apply-test).")

    # Filtre éventuel : résolution d'un host précis
    if args.fp_selftest:
        svc, status = backend.resolve_service(args.fp_selftest)
        msg = {"ok": "→ service « %s »" % svc,
               "unmatched": "host inconnu de la config → whitelist en GLOBAL conseillée (touche g)",
               "unknown": "liste de services indisponible → host utilisé tel quel"}[status]
        line(status == "ok", "résolution de « %s » : %s" % (args.fp_selftest, msg))

    print()
    print("Résumé : %d problème(s) à regarder ci-dessus." % problems[0] if problems[0] else "Résumé : tout est OK, bwtop est pleinement fonctionnel.")
    return 1 if problems[0] else 0


def main():
    ap = argparse.ArgumentParser(
        prog="bwtop", description="Dashboard curses temps réel pour BunkerWeb (trafic HTTP, blocages, raisons, bans).")
    ap.add_argument("source", nargs="?", help="'-' pour lire les logs sur stdin")
    ap.add_argument("-a", "--access", default="/var/log/bunkerweb/access.log", help="access.log nginx/BunkerWeb")
    ap.add_argument("-e", "--error", default="/var/log/bunkerweb/error.log", help="error.log (raisons des blocages)")
    ap.add_argument("--docker", metavar="CONTENEUR", help="suit `docker logs -f CONTENEUR` (access + error)")
    ap.add_argument("--demo", action="store_true", help="trafic et bans synthétiques, sans BunkerWeb")
    ap.add_argument("--backlog", type=int, default=5000, help="lignes d'historique à relire par fichier (défaut 5000)")
    ap.add_argument("--block-status", default=",".join(map(str, DEFAULT_BLOCK_STATUS)),
                    help="codes HTTP considérés comme 'bloqué' (défaut 403,429,444)")
    ap.add_argument("--access-regex", help="regex perso avec groupes nommés ip, time, status [, host, req|method+path, size, ua]")
    ap.add_argument("--dump-unmatched", metavar="FICHIER",
                    help="écrit les lignes d'error.log avec une IP mais sans raison reconnue (pour affiner REASON_RULES)")
    ap.add_argument("--keep-internal", action="store_true", help="ne pas ignorer les health-checks internes (UA/host bwapi)")
    g = ap.add_argument_group("bans BunkerWeb (lus par défaut dans /etc/bunkerweb/variables.env)")
    g.add_argument("--no-bans", action="store_true", help="désactive la vue Bans et l'unban")
    g.add_argument("--bans-api", choices=("instance", "central"), default="instance",
                   help="instance = API interne de BunkerWeb (comme bwcli, défaut) ; central = service bunkerweb-api")
    g.add_argument("--bans-url", help="URL de l'API (défaut http://127.0.0.1:API_HTTP_PORT, ou :8888 en central)")
    g.add_argument("--bans-host", help="en-tête Host (défaut API_SERVER_NAME, sinon bwapi)")
    g.add_argument("--bans-token", help="jeton Bearer (défaut API_TOKEN)")
    g.add_argument("--bans-interval", type=float, default=5.0, help="rafraîchissement des bans en secondes (défaut 5)")
    g.add_argument("--unban-via", choices=("api", "bwcli"), default="api",
                   help="api (défaut) ou bwcli : appelle `bwcli unban` (utile en multi-instances)")
    g.add_argument("--insecure", action="store_true", help="ne pas vérifier le certificat TLS de l'API")
    g.add_argument("--crowdsec-unban", action="store_true",
                   help="démarre avec l'unban CrowdSec activé (bascule en direct avec C dans la vue Bans)")
    g.add_argument("--cscli", default="cscli",
                   help="commande cscli (défaut cscli ; ex. \"docker exec crowdsec cscli\")")
    g.add_argument("--no-crowdsec", action="store_true", help="désactive complètement l'unban CrowdSec")
    gf = ap.add_argument_group("exclusions ModSecurity (whitelist de faux positifs par $host)")
    gf.add_argument("--no-exclusions", "--no-fp-config", dest="no_fp_config", action="store_true",
                    help="désactive l'onglet ModSec et la whitelist")
    gf.add_argument("--exclusions-backend", "--fp-backend", dest="fp_backend", choices=("auto", "api", "file"),
                    default="auto",
                    help="auto (défaut) : API si un token est dispo (bwtop.env), sinon fichier + restart ; "
                         "api = force le plan de contrôle bunkerweb-api ; file = force les fichiers .conf")
    gf.add_argument("--exclusions-config", "--fp-config", dest="fp_config", metavar="FICHIER",
                    help="fichier lu pour le token API (défaut %s puis ~/.config/bwtop/bwtop.env) ; "
                         "format CONFIG_API_URL=... et CONFIG_API_TOKEN=..." % BWTOP_ENV_SYSTEM)
    gf.add_argument("--config-api-url", help="URL du plan de contrôle bunkerweb-api (défaut http://127.0.0.1:8888)")
    gf.add_argument("--config-api-token", help="jeton Bearer du plan de contrôle (sinon lu dans bwtop.env)")
    gf.add_argument("--save-api-token", "--fp-save-token", dest="fp_save_token", action="store_true",
                    help="écrit --config-api-token (et --config-api-url) dans le fichier bwtop.env en 0600, puis quitte")
    gf.add_argument("--modsec-dir", default=MODSEC_DIR,
                    help="dossier des configs modsec pour le backend file (défaut %s)" % MODSEC_DIR)
    gf.add_argument("--reload-cmd", default=None,
                    help="commande de reload pour le backend file (défaut : systemctl restart bunkerweb-scheduler ; "
                         "un simple reload ne réimporte pas les fichiers)")
    gf.add_argument("--exclusions-interval", "--fp-interval", dest="fp_interval", type=float, default=20.0,
                    help="rafraîchissement de la liste des exclusions en s (défaut 20)")
    gf.add_argument("--selftest", "--fp-selftest", dest="fp_selftest", nargs="?", const="", metavar="HOST",
                    help="diagnostic complet de bwtop (environnement, logs, bans, exclusions) et test réel "
                         "de l'application ModSec sur tous les services, puis quitte ; HOST optionnel = filtre de résolution")
    gf.add_argument("--no-apply-test", action="store_true",
                    help="avec --selftest : ne pas écrire de témoin ni recharger le scheduler (diagnostic en lecture seule)")
    gf.add_argument("--fp-apply-test", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("--graph-max", type=float, metavar="REQ_S",
                    help="échelle fixe du graphe en req/s (sinon calibrée au démarrage puis figée ; +/- en direct)")
    ap.add_argument("--setup", "--reconfigure", "--wizard", dest="setup", action="store_true",
                    help="(re)lance l'assistant de configuration (backend d'exclusion, token API, CrowdSec) puis quitte")
    ap.add_argument("--config", help="fichier de configuration (défaut ~/.config/bwtop/config.json)")
    ap.add_argument("--no-color", action="store_true")
    ap.add_argument("-V", "--version", action="version", version="bwtop " + VERSION)
    args = ap.parse_args()

    if args.setup:
        sys.exit(run_wizard(args, explicit=True))

    if args.fp_save_token:
        if not args.config_api_token:
            ap.error("--save-api-token nécessite --config-api-token")
        path = args.fp_config or BWTOP_ENV_SYSTEM
        try:
            os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                f.write("# bwtop : accès au plan de contrôle bunkerweb-api\n")
                f.write("CONFIG_API_URL=%s\n" % (args.config_api_url or "http://127.0.0.1:8888"))
                f.write("CONFIG_API_TOKEN=%s\n" % args.config_api_token)
            os.chmod(path, 0o600)
            print("Token enregistré dans %s (droits 0600)." % path)
            print("bwtop utilisera désormais l'API par défaut. Teste : sudo %s --selftest" % os.path.basename(sys.argv[0]))
            sys.exit(0)
        except OSError as e:
            sys.exit("bwtop: écriture de %s impossible : %s" % (path, e))

    if args.fp_selftest is not None:
        sys.exit(selftest(args))

    # Premier lancement : si aucune config n'existe encore et qu'on est dans un vrai terminal
    # interactif (pas un pipe/cron/docker/demo), on propose l'assistant automatiquement.
    if (not args.demo and args.source != "-" and not args.docker
            and sys.stdin.isatty() and sys.stdout.isatty()):
        try:
            _cfgp, _ = config_path(args.config)
            _first = load_config(_cfgp).get("setup", 0) < 1
        except Exception:
            _first = False
        if _first:
            print("Aucune configuration trouvée — premier lancement de bwtop.\n")
            run_wizard(args, explicit=False)
            print("Démarrage de bwtop…\n")

    try:
        bstat = [int(x) for x in args.block_status.split(",") if x.strip()]
    except ValueError:
        ap.error("--block-status : liste de codes séparés par des virgules")
    rx = re.compile(args.access_regex) if args.access_regex else None

    q = queue.Queue(maxsize=200_000)
    eng = Engine(q, bstat, rx, args.dump_unmatched, args.keep_internal)
    stop = threading.Event()
    threads = []

    def spawn(fn, *a):
        t = threading.Thread(target=fn, args=a, daemon=True)
        t.start()
        threads.append(t)

    if args.demo:
        label = "DEMO"
        spawn(demo_feed, q, stop)
    elif args.source == "-":
        label = "stdin"
        pipe = os.fdopen(os.dup(0), "r", encoding="utf-8", errors="replace")
        try:                                   # le clavier vient du terminal, pas du pipe
            tty = os.open("/dev/tty", os.O_RDONLY)
            os.dup2(tty, 0)
        except OSError:
            sys.exit("bwtop: impossible d'ouvrir /dev/tty pour le clavier")
        spawn(stdin_follow, pipe, q, stop)
    elif args.docker:
        label = "docker:" + args.docker
        spawn(docker_follow, args.docker, q, args.backlog, eng.notes, stop)
    else:
        label = "%s + %s" % (os.path.basename(args.access), os.path.basename(args.error))
        for p in (args.access, args.error):
            spawn(tail_file, p, q, args.backlog, eng.notes, stop)

    bans = None
    client = build_ban_client(args, eng)
    if client is not None:
        cs = None
        if not args.no_crowdsec:
            cs = DemoCrowdSec(client) if isinstance(client, DemoBans) else CrowdSecCli(args.cscli)
        bans = BanManager(client, args.bans_interval, cs)
        spawn(bans.run, stop)

    configmgr = None
    backend = build_config_backend(args, client)
    if backend is not None:
        configmgr = ConfigManager(backend, args.fp_interval)
        spawn(configmgr.run, stop)

    cfg_path, cfg_owner = config_path(args.config)
    cfg = load_config(cfg_path)
    if args.crowdsec_unban:
        cfg["crowdsec_unban"] = True
    if args.graph_max:
        cfg["graph_max"] = args.graph_max

    locale.setlocale(locale.LC_CTYPE, "")      # UTF-8 pour les caracteres de dessin
    ensure_terminfo()
    try:
        curses.wrapper(run, eng, label, not args.no_color, bans, cfg, cfg_path, cfg_owner, configmgr)
    except KeyboardInterrupt:
        pass
    finally:
        stop.set()
        for p in _procs:
            try:
                p.terminate()
            except OSError:
                pass


if __name__ == "__main__":
    main()
