                self.put(yy, x, txt, (a | base) if not sel else (base | curses.A_BOLD), wd)
                x += wd + 1
        if len(rows) > nrows:
            self.put(y + h - 1, w - 22, " %d-%d / %d " % (self.ban_top + 1, min(len(rows), self.ban_top + nrows),
