        self.put(y + 1, 8, "%7.1f" % rps, self.attr[C_OK] | curses.A_BOLD)
        self.put(y + 1, 15, "  moy %.1f   total %s   débit %s/s" % (avg, fmt_n(e.tot_req), fmt_b(bps)))
        self.put(y + 2, 2, "bloquées", curses.A_DIM)
        self.put(y + 2, 11, "%s" % fmt_n(e.w_blocked), self.attr[C_BAD] | curses.A_BOLD)
        line = "  (%.1f%%)  %.2f/s   clients uniques %s" % (pct, brps, fmt_n(len(e.c_ip)))
        if self.bm is not None:
            line += "   bans actifs %s" % ("?" if self.bm.err or self.bm.loading else len(self.bm.bans))
        self.put(y + 2, 11 + len(fmt_n(e.w_blocked)), line, 0, iw - 10 - len(fmt_n(e.w_blocked)))
        self.draw_graph(y + 3, 2, gw, rq, bl)
        peak = max(rq) if rq else 0
        legend = [("█", self.attr[C_OK]), (" autorisées  ", curses.A_DIM), ("█", self.attr[C_BAD]),
                  (" bloquées  ", curses.A_DIM), ("▲", self.attr[C_WARN] | curses.A_BOLD),
                  (" hors échelle  ", curses.A_DIM), ("pic %s/s · échelle +/-" % fmt_rate(peak), curses.A_DIM)]
        lx = 3
        for txt, a in legend:
            self.put(y + top_h - 1, lx, txt, a, tw - 2 - lx)
            lx += len(txt)

        # ---- codes HTTP ----------------------------------------------------
        sx = tw
        sw = w - tw
        self.box(y, sx, top_h, sw, "Codes HTTP")
        tot = max(e.w_total, 1)
        rowsdef = [("2xx", e.c_cls.get(2, 0), C_OK), ("3xx", e.c_cls.get(3, 0), C_INFO),
                   ("4xx", e.c_cls.get(4, 0), C_WARN), ("5xx", e.c_cls.get(5, 0), C_BAD),
                   ("blk", e.w_blocked, C_MAG)]
        bw = max(4, sw - 4 - 4 - 7 - 7)
        for i, (lab, v, col) in enumerate(rowsdef):
            yy = y + 1 + i
            self.put(yy, sx + 2, lab, curses.A_DIM)
            self.put(yy, sx + 6, hbar(v / tot, bw).ljust(bw), self.attr[col], bw)
            self.put(yy, sx + 6 + bw + 1, fmt_n(v).rjust(6), curses.A_BOLD)
        bs = "  ".join("%d×%s" % (k, fmt_n(v)) for k, v in sorted(e.c_bstatus.items()))
        self.put(y + 6, sx + 2, ("blk: " + bs) if bs else "blk: -", curses.A_DIM, sw - 4)
        y += top_h

        # ---- panneaux du milieu -------------------------------------------
        if mid_h:
            w1 = w // 3
            w2 = w // 3
            w3 = w - w1 - w2
            rows = mid_h - 2
            self.ranked(y, 0, mid_h, w1, "Raisons de blocage", top(e.c_reason, rows),
                        colors=lambda k, i: REASON_COLOR.get(k, C_WARN if "unknown" in k else PALETTE[i % 6]),
                        right="%d types" % len(e.c_reason))
            t2, a2 = self.MID_VIEWS[self.mid_view]
