def _scheduler_reject_reason():
    """Lit les logs récents du scheduler (root) pour remonter la vraie raison du rejet d'une config."""
    import shutil
    out = []
    try:
        if shutil.which("journalctl"):
            p = subprocess.run(["journalctl", "-u", "bunkerweb-scheduler", "--since", "2 min ago",
                                "--no-pager", "-n", "300"], capture_output=True, text=True, timeout=15)
            text = p.stdout or ""
        else:
            text = ""
            for lp in ("/var/log/bunkerweb/scheduler.log", "/var/log/bunkerweb/error.log"):
                try:
                    with open(lp, encoding="utf-8", errors="replace") as f:
                        text += f.read()[-20000:]
                except OSError:
                    pass
    except (OSError, subprocess.TimeoutExpired):
        return out
    rx = re.compile(r"(not found|refus|reject|invalid|custom config|Service .* not found|modsec|couldn't save|can't save)", re.I)
    for ln in text.splitlines():
        if rx.search(ln) and "selftest" not in ln and "Checking if there are any changes" not in ln:
            out.append(ANSI_RE.sub("", ln).strip()[:160])
    return out[-6:]


def _probe_services_api(backend, services, line, probe_name, probe_data):
    import time as _t
    posted = []
    for svc in services:
        try:
            backend._call("POST", "/configs", {"type": "modsec", "name": probe_name,
                          "data": probe_data, "service": svc or "global"})
            posted.append(svc)
        except ConfigError as e:
            line(False, "service %-28s : POST refusé — %s" % (svc or "(global)", e))
    _t.sleep(2)
    try:
        _, js = backend._call("GET", "/configs?type=modsec&with_data=false")
    except ConfigError as e:
        line(False, "GET /configs a échoué : %s" % e)
        js = []
    items = js if isinstance(js, list) else (js.get("configs") or js.get("data") or [])
    present = {(it.get("service") or it.get("service_id") or "global") for it in items
               if isinstance(it, dict) and it.get("name") == probe_name}
    okc = 0
    for svc in posted:
        ok = (svc or "global") in present
        line(ok, "service %-28s : %s" % (svc or "(global)", "OK (écrit en base)" if ok else "ÉCHEC"))
        okc += ok
        try:
            backend._call("DELETE", "/configs/%s/modsec/%s" % (svc or "global", probe_name))
        except ConfigError:
            pass
    return okc, len(services)


def _probe_services_file(backend, services, line, probe_name, probe_data):
    import time as _t
    written = []
    for svc in services:
        d = os.path.join(backend.base, svc) if svc else backend.base
        path = os.path.join(d, probe_name + ".conf")
        try:
            os.makedirs(d, exist_ok=True)
            with open(path, "w", encoding="utf-8") as f:
                f.write(probe_data)
            written.append(path)
        except OSError as e:
            line(False, "service %-28s : écriture impossible — %s" % (svc or "(global)", e))
    if not written:
        return 0, len(services)
    print("     %s — un seul redémarrage pour tous les services, patiente ..." % " ".join(backend.reload_cmd))
    try:
        backend.apply()
    except ConfigError as e:
        line(False, "reload/restart a échoué : %s" % e)
        for path in written:
            try:
                os.remove(path)
            except OSError:
                pass
        return 0, len(services)
    _t.sleep(8)
    okc = 0
    for path in written:
        svc = os.path.basename(os.path.dirname(path)) if os.path.dirname(path) != backend.base else ""
        present = os.path.exists(path)
        line(present, "service %-28s : %s" % (svc or "(global)", "OK (importé en base)" if present else "ÉCHEC (effacé)"))
        okc += present
    for path in written:                              # nettoyage : on retire les témoins
        try:
            os.remove(path)
        except OSError:
            pass
    try:
        backend.apply()
    except ConfigError:
        pass
    if okc < len(written):
        reason = _scheduler_reject_reason()
        if reason:
            print("        Raison dans les logs du scheduler :")
            for rl in reason:
                print("          > " + rl)
        if "restart" not in " ".join(backend.reload_cmd):
            print("        → « systemctl reload » ne réimporte pas les fichiers ; utilise")
            print("          --reload-cmd \"systemctl restart bunkerweb-scheduler\"")
    return okc, len(services)


def save_api_token_file(path, url, token):
    """Écrit le fichier bwtop.env (0600) avec l'URL et le token du plan de contrôle. Retourne None ou un message d'erreur."""
    try:
        os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write("# bwtop : accès au plan de contrôle bunkerweb-api\n")
            f.write("CONFIG_API_URL=%s\n" % (url or "http://127.0.0.1:8888"))
            f.write("CONFIG_API_TOKEN=%s\n" % token)
        os.chmod(path, 0o600)
        return None
    except OSError as e:
        return str(e)


def detect_crowdsec(args):
    """(cscli_present, service_actif|None)."""
    import shutil
    cmd = (args.cscli or "cscli").split()[0]
    have = bool(shutil.which(cmd) or os.path.exists(cmd))
    active = None
    if shutil.which("systemctl"):
        try:
            r = subprocess.run(["systemctl", "is-active", "crowdsec"], capture_output=True, text=True, timeout=5)
            active = r.stdout.strip() == "active"
        except (OSError, subprocess.TimeoutExpired):
            active = None
    return have, active


