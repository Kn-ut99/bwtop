class ConfigManager:
    """Thread de travail pour les exclusions ModSec (I/O réseau ou reload bloquants)."""

    def __init__(self, backend, interval=20.0):
        self.backend, self.interval = backend, max(2.0, interval)
        self.exclusions = []
        self.keys = set()               # {(service, rid)} actifs
        self.err = None
        self.loading = True
        self.last = None                # (monotonic, texte, ok) : dernière action, affichée en continu
        self._added = set()             # ajouts à revérifier après reload
        self._verify_at = 0.0
        self.actions = queue.Queue()
        self.wake = threading.Event()
        self.msgs = collections.deque(maxlen=20)

    def refresh(self):
        self.wake.set()

    def excluded(self, host, rid):
        return (host, rid) in self.keys or ("", rid) in self.keys

    def toggle(self, host, rid, msg, scope_global=False):
        self.actions.put(("toggle", host, rid, msg, scope_global))
        self.wake.set()

    def _say(self, txt, ok):
        self.msgs.append((time.monotonic(), txt, ok))
        self.last = (time.monotonic(), txt, ok)

    def _fetch(self):
        try:
            self.exclusions = self.backend.list_exclusions()
            self.keys = {(e["service"], e["rid"]) for e in self.exclusions}
            self.err = None
        except ConfigError as e:
            self.err = str(e)
        except Exception as e:
            self.err = "%s: %s" % (type(e).__name__, e)
        self.loading = False

    def _do(self, host, rid, msg, scope_global):
        """Applique une bascule sans recharger (le reload est groupé ensuite). Renvoie True si modifié."""
        service = "" if scope_global else host
        existing = next((e for e in self.exclusions if e["rid"] == rid and e["service"] == service), None)
        label = "globalement" if not service else "pour %s" % service
        auto = self.backend.kind == "api"      # l'API applique via le scheduler, pas de reload à lancer
        try:
            if existing:
                self.backend.remove(existing, reload_after=False)
                self._say("✔ règle %s réactivée %s%s" % (
                    rid, label, " (appliqué par le scheduler)" if auto else ""), True)
            else:
                svc, status = (service, "ok")
                if service:
                    svc, status = self.backend.resolve_service(host)
                    service = svc
                self.backend.add(service, rid, msg, reload_after=False)
                extra = "" if status != "unmatched" else " [%s inconnu comme service : vérifie le scope]" % host
                self._say("✔ règle %s désactivée %s%s%s" % (
                    rid, ("pour %s" % service) if service else "globalement",
                    " (appliqué par le scheduler)" if auto else "", extra), True)
                self._added.add((service, rid))        # à revérifier après le reload
            return True
        except ConfigError as e:
            self._say("✘ règle %s : %s" % (rid, e), False)
        except Exception as e:
            self._say("✘ règle %s : %s" % (rid, e), False)
        return False

    def run(self, stop):
        last = 0.0
        while not stop.is_set():
            changed = 0
            try:
                while True:
                    _, host, rid, msg, sg = self.actions.get_nowait()
                    if self._do(host, rid, msg, sg):
                        changed += 1
            except queue.Empty:
                pass
            if changed and self.backend.kind != "api":
                # un seul reload du scheduler, même pour plusieurs whitelists d'affilée
                try:
                    self.backend.apply()
                    self._say("↻ scheduler rechargé — %d modification(s) appliquée(s)" % changed, True)
                except ConfigError as e:
                    self._say("✘ fichiers écrits mais reload échoué : %s — relance le scheduler" % e, False)
                except Exception as e:
                    self._say("✘ reload du scheduler : %s" % e, False)
            if changed and self._added:
                self._verify_at = time.monotonic() + 6.0    # laisser le scheduler traiter
            if changed or self.wake.is_set() or time.monotonic() - last >= self.interval:
                self.wake.clear()
                self._fetch()
                last = time.monotonic()
            if self._verify_at and time.monotonic() >= self._verify_at:
                self._verify_at = 0.0
                self._fetch()
                gone = {k for k in self._added if k not in self.keys}
                self._added = set()
                if gone:
                    ex = ", ".join("%s/%s" % (svc or "global", rid) for svc, rid in sorted(gone))
                    hint = (" Utilise --reload-cmd \"systemctl restart bunkerweb-scheduler\" (reload ne scanne pas les fichiers)."
                            if "restart" not in " ".join(getattr(self.backend, "reload_cmd", [])) else
                            " Diagnostique avec : bwtop --selftest.")
                    self._say("⚠ exclusion disparue après reload (%s) : le scheduler ne l'a pas importée.%s" % (ex, hint), False)
            self.wake.wait(0.3)



