        rows = self.ban_rows = self.compute_ban_rows()
        age = time.monotonic() - bm.ok_at if bm.ok_at else None
        right = "tri : %s · CrowdSec %s (C)" % (self.BAN_SORTS[self.ban_sort][1],
                                                 "ON" if self.cs_on else "off")
        if self.ban_filter:
            right = "filtre « %s » · " % self.ban_filter + right
        self.box(y, 0, h, w, "Bans BunkerWeb", right)
        iw = w - 4
        info = "Source : %s" % bm.client.label()
        if self.cs_on:
            info += "   ·   unban CrowdSec actif : %s" % bm.cs.label()
        if age is not None:
            info += "   ·   %d bans, mis à jour il y a %ds" % (len(bm.bans), age)
