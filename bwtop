        if bm.loading:
            self.put(top_y + 1, 3, "Chargement…", curses.A_DIM)
            return
        ipw = min(39, max([len(b["ip"]) for b in rows] + [7]))
        fixed = [("", 1), ("IP", ipw), ("PORTÉE / SITE", 22), ("BANNI LE", 14), ("RESTANT", 9),
                 ("PAYS", 4), ("TYPE", 8), ("REQ BLOQ.", 9)]
        rest = iw - sum(wd for _, wd in fixed) - len(fixed)
        if rest < 12:                                 # terminal etroit : on retire des colonnes
            fixed = [c for c in fixed if c[0] not in ("PAYS", "TYPE")]
            rest = iw - sum(wd for _, wd in fixed) - len(fixed)
        cols = fixed[:3] + [("RAISON", max(8, rest))] + fixed[3:]
