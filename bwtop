#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
bwtop - dashboard temps reel (curses) pour BunkerWeb, façon htop / btop.

Sources de logs possibles :
  * fichiers   : bwtop -a /var/log/bunkerweb/access.log -e /var/log/bunkerweb/error.log
  * docker     : bwtop --docker bunkerweb
  * stdin      : ssh srv docker logs -f bunkerweb 2>&1 | bwtop -
  * demo       : bwtop --demo        (trafic synthetique, pour tester l'affichage)

Touches principales : Tab bascule Dashboard <-> Bans (unban avec u), c configure les colonnes,
h affiche l'aide. Les bans sont lus via l'API interne de BunkerWeb (la meme que bwcli), dont
l'adresse, le Host et le jeton sont lus dans /etc/bunkerweb/variables.env.

Aucune dependance externe : Python 3.8+ et le module standard `curses`.
"""
import argparse
import calendar
import collections
import curses
import heapq
import locale
import os
import queue
import random
import re
import subprocess
import sys
import threading
import time
from datetime import datetime

VERSION = "1.8.0"

WINDOWS = [("1m", 60), ("5m", 300), ("15m", 900), ("1h", 3600)]
RETENTION = 3600            # on garde 1h d'evenements en memoire
MAX_EVENTS = 400_000        # garde-fou memoire
RESOLVE_DELAY = 1.5         # s d'attente avant d'attribuer une raison a un blocage
CORR_WINDOW = 5.0           # s de tolerance entre ligne access.log et error.log
DEFAULT_BLOCK_STATUS = (403, 429, 444)

# --------------------------------------------------------------------------- #
#  Parsing des logs
# --------------------------------------------------------------------------- #

# Formats acceptes (le premier est le LOG_FORMAT par defaut de BunkerWeb 1.6.x) :
#   $host $remote_addr - $request_id $remote_user [$time_local] "$request" ...
#   $host $remote_addr - $remote_user [$time_local] "$request" ...       (BunkerWeb plus ancien)
#   $remote_addr - $remote_user [$time_local] "$request" ...             (nginx "combined")
ACCESS_RE = re.compile(
    r'(?:(?P<host>[^\s"\[\]]+) )?(?P<ip>[0-9a-fA-F:.]{3,45}) - (?:(?P<rid>[0-9a-f]{32}) )?\S+ '
    r'\[(?P<time>\d\d/\w{3}/\d{4}:[^\]]+)\] '
    r'"(?P<req>[^"]*)" (?P<status>\d{3}) (?P<size>\d+|-)'
    r'(?: "(?P<ref>[^"]*)" "(?P<ua>[^"]*)")?'
)
ERROR_RE = re.compile(r'^(?P<time>\d{4}/\d\d/\d\d \d\d:\d\d:\d\d) \[(?P<level>\w+)\] ')
DOCKER_TS_RE = re.compile(r'^(\d{4})-(\d\d)-(\d\d)T(\d\d):(\d\d):(\d\d)(?:\.\d+)?(?:Z|[+-]\d\d:\d\d)? ')

IP_RE = re.compile(r'(?:client:? |\[client |\bIP |\bip |\bremote_addr:? )\[?([0-9a-fA-F:.]{3,45})')
REQ_RE = re.compile(r'request: "[A-Z]+ (\S+) HTTP/[\d.]+"')
URI_RE = re.compile(r'\[uri "([^"]*)"\]')
MSG_RE = re.compile(r'\[msg "((?:[^"\\]|\\.)*)"\]')
ID_RE = re.compile(r'\[id "(\d+)"\]')
WHITELIST_RE = re.compile(r'whitelist|allowlist', re.I)
HOST_ERR_RE = re.compile(r'(?:,|^|\s)host: "([^"]*)"')
SERVER_ERR_RE = re.compile(r'(?:,|\s)server: (\S+?)(?:,|\s|$)')

# ---> Categories de blocage detectees dans l'error.log (ordre = priorite).
#      Adapte librement ces motifs a ta version / tes plugins BunkerWeb.
REASON_RULES = [
    ("crowdsec",     re.compile(r'crowdsec', re.I)),
    ("dnsbl",        re.compile(r'dnsbl', re.I)),
    ("antibot",      re.compile(r'antibot|captcha|challenge', re.I)),
    ("rate-limit",   re.compile(r'limiting requests|limit[_ -]?req|rate[ -]?limit|too many requests', re.I)),
    ("conn-limit",   re.compile(r'limiting connections|limit[_ -]?conn', re.I)),
    ("bad-behavior", re.compile(r'bad[ _-]?behavior|increased counter', re.I)),
    ("banned",       re.compile(r'\bban(?:ned)?\b', re.I)),
    ("blacklist",    re.compile(r'blacklist|denylist', re.I)),
    ("country",      re.compile(r'\bcountry\b', re.I)),
    ("auth-basic",   re.compile(r'was not found in|password mismatch|no user/password', re.I)),
]
ANOMALY_IDS = {"949110", "959100", "980130"}   # regles CRS "score global" (peu parlantes)

MONTHS = {m: i + 1 for i, m in enumerate("Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec".split())}
_clf_cache, _err_cache = {}, {}
_clean_re = re.compile(r'[^\x20-\x7e]')


def parse_clf(s):
    """'17/Oct/2026:12:34:56 +0200' -> epoch (sans dependre de la locale)."""
    v = _clf_cache.get(s)
    if v is None:
        try:
            ts = calendar.timegm((int(s[7:11]), MONTHS[s[3:6]], int(s[0:2]),
                                  int(s[12:14]), int(s[15:17]), int(s[18:20])))
            tz = s[21:26]
            if len(tz) == 5 and tz[0] in "+-":
                off = (int(tz[1:3]) * 3600 + int(tz[3:5]) * 60) * (1 if tz[0] == "+" else -1)
                ts -= off
            v = float(ts)
        except (ValueError, KeyError, IndexError):
            v = time.time()
        if len(_clf_cache) > 10000:
            _clf_cache.clear()
        _clf_cache[s] = v
    return v


def parse_err_time(s):
    """'2026/10/17 12:34:56' (heure locale du serveur) -> epoch."""
    v = _err_cache.get(s)
    if v is None:
        try:
            v = time.mktime(time.strptime(s, "%Y/%m/%d %H:%M:%S"))
        except ValueError:
            v = time.time()
        if len(_err_cache) > 10000:
            _err_cache.clear()
        _err_cache[s] = v
    return v


def clean(s, n):
    return _clean_re.sub("?", s[:n])


def classify_error(line):
    """Retourne (ip, categorie, detail, deny, uri) ou None."""
    if WHITELIST_RE.search(line) and "blacklist" not in line.lower():
        return None
    mi = IP_RE.search(line)
    if not mi:
        return None
    ip = mi.group(1).rstrip(":.")
    mu = REQ_RE.search(line) or URI_RE.search(line)
    uri = mu.group(1) if mu else ""

    if "ModSecurity" in line:
        deny = "Access denied" in line
        if not deny and "ModSecurity: Warning" not in line:
            return None
        mid, mmsg = ID_RE.search(line), MSG_RE.search(line)
        rid = mid.group(1) if mid else ""
        msg = mmsg.group(1) if mmsg else ""
        detail = (rid + " " + msg).strip()
        if rid in ANOMALY_IDS and not deny:
            detail = ""
        return ip, "modsecurity", clean(detail, 90), deny, uri

    for cat, rx in REASON_RULES:
        if rx.search(line):
            return ip, cat, "", True, uri
    return None


# --------------------------------------------------------------------------- #
#  Moteur de statistiques
# --------------------------------------------------------------------------- #

class Ev:
    __slots__ = ("ts", "ip", "method", "path", "status", "size", "ua",
                 "blocked", "reason", "detail", "resolved", "inwin", "arr", "host")


def _bump(c, k, s):
    n = c.get(k, 0) + s
    if n > 0:
        c[k] = n
    else:
        c.pop(k, None)


def top(counter, n):
    return heapq.nlargest(n, counter.items(), key=lambda kv: kv[1])


class Engine:
    def __init__(self, q, block_status, access_re=None, dump_path=None, keep_internal=False):
        self.q = q
        self.keep_internal = keep_internal
        self.block_status = set(block_status)
        self.access_re = access_re or ACCESS_RE
        self.dump = open(dump_path, "a") if dump_path else None
        self.notes = {}                       # messages d'etat des lecteurs
        self.window_secs = 300
        self.start = time.time()
        self.seq = 0
        self.seen_host = False
        self.modsec = {}          # (host, rule_id) -> agrégat des déclenchements ModSecurity
        self.reset()

    # -- etat ------------------------------------------------------------- #
    def reset(self):
        self.events = collections.deque()      # tous (1h)
        self.modsec = {}
        self.win = collections.deque()         # dans la fenetre courante
        self.blocked_events = collections.deque()
        self.pending = collections.deque()
        self.rindex = {}
        self.sec = {}
        self.tot_req = self.tot_blocked = self.tot_bytes = 0
        self.unparsed = 0
        self._clear_counters()
        self._last_prune = time.monotonic()

    def _clear_counters(self):
        self.w_total = self.w_blocked = self.w_bytes = 0
        self.c_cls = {}        # 2xx..5xx
        self.c_method = {}
        self.c_ip = {}         # tous les clients
        self.c_bstatus = {}    # 403 / 429 / 444
        self.c_reason = {}
        self.c_bip = {}
        self.c_burl = {}
        self.c_bua = {}
        self.c_rule = {}
        self.c_host = {}       # sites (toutes requetes)
        self.c_bhost = {}      # sites (bloquees)

    def _apply_base(self, ev, s):
        self.w_total += s
        self.w_bytes += s * ev.size
        _bump(self.c_cls, ev.status // 100, s)
        _bump(self.c_method, ev.method, s)
        _bump(self.c_ip, ev.ip, s)
        if ev.host:
            _bump(self.c_host, ev.host, s)
        if ev.blocked:
            self.w_blocked += s
            _bump(self.c_bstatus, ev.status, s)

    def _apply_blocked(self, ev, s):
        _bump(self.c_reason, ev.reason, s)
        _bump(self.c_bip, ev.ip, s)
        if ev.host:
            _bump(self.c_bhost, ev.host, s)
        _bump(self.c_burl, ev.path.split("?", 1)[0], s)
        if ev.ua:
            _bump(self.c_bua, ev.ua, s)
        if ev.reason == "modsecurity" and ev.detail:
            _bump(self.c_rule, ev.detail, s)

    def set_window(self, secs):
        self.window_secs = secs
        self._clear_counters()
        self.win.clear()
        cut = time.time() - secs
        for ev in self.events:
            if ev.ts >= cut:
                self.win.append(ev)
                ev.inwin = True
                self._apply_base(ev, 1)
                if ev.blocked and ev.resolved:
                    self._apply_blocked(ev, 1)
            else:
                ev.inwin = False

    # -- ingestion -------------------------------------------------------- #
    def pump(self, budget=0.08):
        t0, n = time.monotonic(), 0
        while True:
            try:
                line, hint = self.q.get_nowait()
            except queue.Empty:
                break
            self.ingest(line, hint)
            n += 1
            if n & 63 == 0 and time.monotonic() - t0 > budget:
                break
        self._resolve_pending()
        self._expire()
        if time.monotonic() - self._last_prune > 15:
            self._prune_index()

    def ingest(self, line, hint):
        if not line:
            return
        m = self.access_re.search(line) if '"' in line else None
        if m:
            self._on_access(m.groupdict())
            return
        me = ERROR_RE.match(line)
        if me:
            self._on_error(line, me, hint)
            return
        self.unparsed += 1

    def _on_access(self, g):
        try:
            status = int(g["status"])
        except (ValueError, KeyError, TypeError):
            return
        method = g.get("method")
        if method:
            path = g.get("path") or ""
        else:
            parts = (g.get("req") or "").split(" ", 2)
            method, path = (parts[0], parts[1]) if len(parts) >= 2 else ("-", g.get("req") or "")
        size = g.get("size")
        ts = parse_clf(g["time"]) if g.get("time") else time.time()
        if ts < time.time() - RETENTION:
            return
        if not self.keep_internal and (g.get("ua") == "bwapi" or g.get("host") == "bwapi"):
            return                      # health-checks internes de BunkerWeb
        ev = Ev()
        ev.ts, ev.ip, ev.status = ts, g["ip"], status
        ev.method, ev.path = clean(method, 8), clean(path, 300)
        ev.size = int(size) if size and size.isdigit() else 0
        ev.ua = clean(g.get("ua") or "", 120)
        ev.host = clean((g.get("host") or "").lower(), 80)
        if ev.host:
            self.seen_host = True
        ev.blocked = status in self.block_status
        ev.reason = ev.detail = ""
        ev.resolved = not ev.blocked
        ev.arr = time.monotonic()
        ev.inwin = ts >= time.time() - self.window_secs

        self.seq += 1
        self.tot_req += 1
        self.tot_bytes += ev.size
        self.events.append(ev)
        b = self.sec.setdefault(int(ts), [0, 0, 0])
        b[0] += 1
        b[2] += ev.size
        if ev.blocked:
            self.tot_blocked += 1
            b[1] += 1
            self.blocked_events.append(ev)
            self.pending.append(ev)
        if ev.inwin:
            self.win.append(ev)
            self._apply_base(ev, 1)

    def _on_error(self, line, me, hint):
        r = classify_error(line)
        if r is None:
            if self.dump and IP_RE.search(line) and me.group("level") not in ("info", "debug"):
                self.dump.write(line + "\n")
                self.dump.flush()
            return
        ip, cat, detail, deny, uri = r
        ts = hint if hint is not None else parse_err_time(me.group("time"))
        d = self.rindex.get(ip)
        if d is None:
            d = self.rindex[ip] = collections.deque(maxlen=40)
        d.append((ts, cat, detail, deny, uri))
        if cat == "modsecurity":
            mid = ID_RE.search(line)
            rid = mid.group(1) if mid else ""
            if rid and rid not in ANOMALY_IDS:        # on ne whiteliste jamais la règle de score global
                mmsg = MSG_RE.search(line)
                mh = HOST_ERR_RE.search(line) or SERVER_ERR_RE.search(line)
                host = clean((mh.group(1) if mh else "").strip('"').lower(), 80)
                self._modsec_hit(ts, host, ip, rid, clean(mmsg.group(1), 90) if mmsg else "", uri, deny)

    def _modsec_hit(self, ts, host, ip, rid, msg, uri, deny):
        key = (host, rid)
        h = self.modsec.get(key)
        if h is None:
            if len(self.modsec) >= 5000:              # garde-fou mémoire : on jette le plus ancien
                old = min(self.modsec, key=lambda k: self.modsec[k]["last"])
                del self.modsec[old]
            h = self.modsec[key] = {"host": host, "rid": rid, "msg": msg, "count": 0, "deny": 0,
                                    "first": ts, "last": ts, "uri": uri, "ips": {}}
        h["count"] += 1
        if deny:
            h["deny"] += 1
        h["last"] = max(h["last"], ts)
        h["first"] = min(h["first"], ts)
        if msg:
            h["msg"] = msg
        if uri:
            h["uri"] = uri
        info = h["ips"].get(ip)
        if info is None and len(h["ips"]) < 256:       # garde-fou : au plus 256 IP distinctes mémorisées
            info = h["ips"][ip] = [0, ts, ts, uri]
        if info is not None:
            info[0] += 1
            info[1] = min(info[1], ts)
            info[2] = max(info[2], ts)
            if uri:
                info[3] = uri

    def _resolve(self, ev):
        cands = []
        for e in self.rindex.get(ev.ip, ()):
            if abs(e[0] - ev.ts) <= CORR_WINDOW:
                cands.append(e)
        if cands:
            exact = [c for c in cands if c[4] and c[4] == ev.path]
            if exact:
                cands = exact
            non_mod = [c for c in cands if c[1] != "modsecurity"]
            if non_mod:
                ev.reason, ev.detail = non_mod[-1][1], non_mod[-1][2]
            else:
                specific = [c[2] for c in cands if c[2] and not c[3]]
                ev.reason = "modsecurity"
                ev.detail = specific[0] if specific else cands[-1][2]
        else:
            ev.reason = {429: "rate-limit (429)", 444: "dropped (444)"}.get(
                ev.status, "unknown (%d)" % ev.status)
        ev.resolved = True
        if ev.inwin:
            self._apply_blocked(ev, 1)

    def _resolve_pending(self):
        now = time.monotonic()
        while self.pending and now - self.pending[0].arr >= RESOLVE_DELAY:
            self._resolve(self.pending.popleft())

    def _expire(self):
        now = time.time()
        cut = now - self.window_secs
        while self.win and self.win[0].ts < cut:
            ev = self.win.popleft()
            ev.inwin = False
            self._apply_base(ev, -1)
            if ev.blocked and ev.resolved:
                self._apply_blocked(ev, -1)
        cut = now - RETENTION
        while self.events and (self.events[0].ts < cut or len(self.events) > MAX_EVENTS):
            self.events.popleft()
        while self.blocked_events and self.blocked_events[0].ts < cut:
            self.blocked_events.popleft()
        if self.modsec:
            for k in [k for k, v in self.modsec.items() if v["last"] < cut]:
                del self.modsec[k]
        if len(self.sec) > RETENTION + 120:
            for k in [k for k in self.sec if k < cut]:
                del self.sec[k]

    def _prune_index(self):
        self._last_prune = time.monotonic()
        cut = time.time() - 300
        for ip in [ip for ip, d in self.rindex.items() if d and d[-1][0] < cut - 86400 * 2]:
            del self.rindex[ip]
        if len(self.rindex) > 200_000:
            self.rindex.clear()

    # -- lecture pour l'UI ------------------------------------------------- #
    def rates(self, secs=5):
        base = int(time.time()) - 1
        r = b = by = 0
        for s in range(base - secs + 1, base + 1):
            v = self.sec.get(s)
            if v:
                r += v[0]
                b += v[1]
                by += v[2]
        return r / secs, b / secs, by / secs

    def series(self, n, now=None):
        """Debit moyen (req/s, bloquees/s) par barre, au plus n barres couvrant la fenetre.

        - chaque barre couvre un nombre ENTIER de secondes (pas d'alternance 2 s / 3 s) ;
        - les barres sont ancrees sur l'horloge (s // pas) : elles defilent, elles ne glissent pas ;
        - la seconde en cours (incomplete) est exclue ; la derniere barre, partielle, est
          divisee par le nombre de secondes reellement ecoulees (pas de chute a droite).
        Retourne (req, blk, pas_en_secondes).
        """
        W = self.window_secs
        n = max(1, n)
        step = max(1, -(-W // n))
        nb = -(-W // step)
        last = int(time.time() if now is None else now) - 1      # derniere seconde terminee
        cur_b = last // step
        first_b = cur_b - nb + 1
        req, blk = [0.0] * nb, [0.0] * nb
        for s in range(first_b * step, last + 1):
            v = self.sec.get(s)
            if v:
                i = s // step - first_b
                req[i] += v[0]
                blk[i] += v[1]
        div = [float(step)] * nb
        div[-1] = float(last - cur_b * step + 1)
        return [r / d for r, d in zip(req, div)], [b / d for b, d in zip(blk, div)], step

    def span(self):
        if self.win:
            return max(1.0, min(self.window_secs, time.time() - self.win[0].ts))
        return float(self.window_secs)

    def reason_of(self, ev):
        if not ev.blocked:
            return ""
        if not ev.resolved:
            return "..."
        return ev.reason + (": " + ev.detail if ev.detail else "")


