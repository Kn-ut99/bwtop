def fmt_n(n):
    n = float(n)
    for unit in ("", "k", "M", "G"):
        if abs(n) < 1000 or unit == "G":
            return ("%d" % n if unit == "" else "%.1f%s" % (n, unit))
        n /= 1000.0


def fmt_b(n):
    n = float(n)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if abs(n) < 1024 or unit == "TB":
            return "%.0f%s" % (n, unit) if unit == "B" else "%.1f%s" % (n, unit)
        n /= 1024.0


def fmt_rate(v):
    v = float(v)
    if v >= 1000:
        return ("%.1fk" % (v / 1000)).replace(".0k", "k")
    return "%.0f" % v if v >= 10 or v == int(v) else "%.1f" % v


def fmt_dur(s):
    s = int(max(0, s))
    d, s = divmod(s, 86400)
    h, s = divmod(s, 3600)
    m, s = divmod(s, 60)
    if d:
        return "%dj%02dh" % (d, h)
    if h:
        return "%dh%02dm" % (h, m)
    return "%dm%02ds" % (m, s)


def elide(s, n, middle=False):
    """Tronque a n caracteres ; au milieu pour les IP (debut et fin restent lisibles)."""
    if n <= 0:
        return ""
    if len(s) <= n:
        return s
    if n == 1:
        return "…"
    if middle:
        a = n // 2
        b = n - 1 - a
        return s[:a] + "…" + (s[-b:] if b else "")
    return s[:n - 1] + "…"


def hbar(frac, width):
    frac = max(0.0, min(1.0, frac))
    full, part = divmod(int(round(frac * width * 8)), 8)
    return "█" * full + (PART[part] if part and full < width else "")


