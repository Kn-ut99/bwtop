def demo_feed(q, stop):
    rnd = random.Random()
    good = ["%d.%d.%d.%d" % (rnd.choice((82, 90, 78, 176, 51)), rnd.randint(1, 250),
                             rnd.randint(1, 250), rnd.randint(1, 250)) for _ in range(250)]
    bad = ["%d.%d.%d.%d" % (rnd.choice((45, 185, 193, 103, 141)), rnd.randint(1, 250),
