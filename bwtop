        wname, _ = WINDOWS[self.win_idx]
        avail = h - 2
        top_h = 8
        mid_h = 8 if avail >= 30 else 6
        feed_h = avail - top_h - mid_h
        if feed_h < 5:
            mid_h = 0
            feed_h = avail - top_h
        y = 1

        # ---- trafic --------------------------------------------------------
        tw = max(44, int(w * 0.62))
        gw = max(10, tw - 4 - 7)
        rq, bl, step = e.series(gw)
        self.box(y, 0, top_h, tw, "Trafic HTTP", "fenêtre %s · 1 barre = %s" % (
            wname, "%d s" % step if step < 60 else "%d min %02d s" % divmod(step, 60)))
        iw = tw - 4
        rps, brps, bps = e.rates()
        span = e.span()
        avg = e.w_total / span
        pct = 100.0 * e.w_blocked / e.w_total if e.w_total else 0.0
