def default_columns():
    return [{"id": c, "on": c in DEFAULT_ON, "width": d[1]} for c, d in COLDEF.items()]


def config_path(override=None):
    if override:
        return override, None
    owner = None
    sudo_user = os.environ.get("SUDO_USER")
    if sudo_user and hasattr(os, "geteuid") and os.geteuid() == 0:
        try:
            import pwd
            pw = pwd.getpwnam(sudo_user)
            return os.path.join(pw.pw_dir, ".config", "bwtop", "config.json"), (pw.pw_uid, pw.pw_gid)
        except (KeyError, ImportError):
            pass
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    return os.path.join(base, "bwtop", "config.json"), owner


def load_config(path):
    import json
    cfg = {"columns": default_columns(), "crowdsec_unban": False, "graph_max": None, "setup": 0}
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
        cols, seen = [], set()
        for c in data.get("columns", []):
            cid = c.get("id")
            if cid in COLDEF and cid not in seen:
                d = COLDEF[cid]
                wd = int(c.get("width", d[1]))
                if not (cid == "ip" and wd == 0):
                    wd = max(d[2], min(d[3], wd))
                cols.append({"id": cid, "on": bool(c.get("on")), "width": wd})
                seen.add(cid)
        for c in default_columns():                      # colonnes ajoutees dans une version future
            if c["id"] not in seen:
                cols.append(c)
        if cols:
            cfg["columns"] = cols
        cfg["crowdsec_unban"] = bool(data.get("crowdsec_unban", False))
        gm = data.get("graph_max")
        cfg["graph_max"] = gm if isinstance(gm, (int, float)) and gm > 0 else None
        cfg["setup"] = int(data.get("setup", 0) or 0)
    except (OSError, ValueError, TypeError, AttributeError):
        pass
    return cfg


def save_config(path, owner, cfg):
    import json
    try:
        d = os.path.dirname(path)
        os.makedirs(d, exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump({"version": 1, "setup": int(cfg.get("setup", 0) or 0),
                       "crowdsec_unban": bool(cfg.get("crowdsec_unban")), "graph_max": cfg.get("graph_max"),
                       "columns": cfg["columns"]}, f, indent=2, ensure_ascii=False)
        os.replace(tmp, path)
        if owner:
            for p in (os.path.dirname(d), d, path):
                try:
                    os.chown(p, *owner)
                except OSError:
                    pass
        return None
    except OSError as e:
        return str(e)


